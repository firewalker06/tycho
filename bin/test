#!/usr/bin/env ruby
# frozen_string_literal: true

require "open3"
require "tmpdir"

ROOT = File.expand_path("..", __dir__)
require File.join(ROOT, "test/support/test_environment")

test_files = Dir.glob(File.join(ROOT, "test", "*_test.rb")).sort.map do |path|
  path.delete_prefix("#{ROOT}/")
end

commands = [
  ["bundle", "exec", "ruby", "-c", "bin/tycho"],
  ["bundle", "exec", "ruby", "-c", "bin/schedule"],
  ["ruby", "bin/tycho", "doctor"]
] +
           test_files.map { |path| ["bundle", "exec", "ruby", "-r", File.join(ROOT, "test/support/push_safety.rb"), path] }

commands.each do |command|
  puts "$ #{command.join(" ")}"
  success = Dir.mktmpdir("tycho-test-command-") do |logs_root|
    system(TestEnvironment.command_env(logs_root), *command, chdir: ROOT)
  end
  exit($?.exitstatus || 1) unless success
end

puts "bin/test: ok"
