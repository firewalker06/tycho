#!/usr/bin/env ruby
# frozen_string_literal: true

require "fileutils"
require "json"
require "net/http"
require "socket"
require "tmpdir"

require_relative "../lib/hq/domain/file_store"

ROOT = File.expand_path("..", __dir__)
OUTPUT = File.expand_path(ENV.fetch("TYCHO_PERSONAL_ASSISTANT_CAPTURE_OUTPUT", "~/.tycho/artifacts/card-170/fred-reset-settings"))
PORT = TCPServer.open("127.0.0.1", 0) { |server| server.addr[1] }

def request(path, payload = nil)
  request = payload ? Net::HTTP::Post.new(path, "Content-Type" => "application/json") : Net::HTTP::Get.new(path)
  request.body = JSON.generate(payload) if payload
  Net::HTTP.start("127.0.0.1", PORT) { |http| http.request(request) }
end

def wait_for_server
  100.times do
    return if request("/personal-assistant").is_a?(Net::HTTPSuccess)

    sleep 0.1
  rescue Errno::ECONNREFUSED
    sleep 0.1
  end
  raise "Personal Assistant fixture server did not start"
end

Dir.mktmpdir("tycho-pa-capture") do |dir|
  FileUtils.mkdir_p(OUTPUT)
  config = File.join(dir, "hq.yml")
  schedules = File.join(dir, "schedules.yml")
  File.write(schedules, "---\nschedules: []\n")
  File.write(config, <<~YAML)
    ---
    custom_harnesses: []
    harness_catalogs: {}
    groups: {}
    projects:
      - key: fixture
        name: Personal Assistant fixture
        path: #{ROOT}
        harnesses: []
  YAML
  tycho_home = File.join(dir, "tycho-home")
  env = { "TYCHO_HOME" => tycho_home, "TYCHO_CONFIG_PATH" => config, "TYCHO_SYSTEM_PROMPTS_PATH" => File.join(ROOT, "config/system_prompts.yml.example"), "TYCHO_LOGS_ROOT" => File.join(dir, "logs"), "TYCHO_SCHEDULES_PATH" => schedules, "TYCHO_REMOTE_TOKEN" => "" }
  pid = Process.spawn(env, "bundle", "exec", "bin/tycho", "serve", "--host", "127.0.0.1", "--port", PORT.to_s, chdir: ROOT, out: File.join(dir, "server.log"), err: File.join(dir, "server.log"))
  begin
    wait_for_server
    capture = ->(name, device, selector, expected, route: "personal-assistant", open_menu: false, open_switcher: false, keyboard_switcher: false) do
      playwright = ENV.fetch("TYCHO_PLAYWRIGHT_PATH", File.expand_path("node_modules/playwright", ROOT))
      raise "Install deterministic Playwright dependency at #{playwright} or set TYCHO_PLAYWRIGHT_PATH" unless File.directory?(playwright)
      script = File.join(dir, "capture.js")
      File.write(script, <<~JS)
        const { chromium, devices } = require(#{playwright.to_json});
        (async () => { const browser = await chromium.launch({headless:true}); const page = await browser.newPage(devices[#{device.to_json}]); if (#{device.to_json} === 'Desktop Chrome') await page.setViewportSize({ width: 1280, height: 900 }); await page.goto('http://127.0.0.1:#{PORT}/ui##{route}'); const target = page.locator(#{selector.to_json}); await target.waitFor({state:'visible',timeout:15000}); await page.waitForFunction(() => { const boot = document.querySelector('#tycho-boot-shell'); return !boot || getComputedStyle(boot).display === 'none' || getComputedStyle(boot).visibility === 'hidden'; }, null, {timeout:15000}); await page.waitForFunction(() => document.body.innerText.includes(#{expected.to_json}), null, {timeout:15000}); if (#{open_menu}) { await page.locator('#personal-assistant-settings-menu > summary').click(); await page.locator('[data-open-settings]').waitFor({state:'visible',timeout:15000}); } if (#{open_switcher}) { await page.locator('[data-agent-switcher]').click(); await page.locator('#unread-agents-panel:not(.hidden)').waitFor({state:'visible',timeout:15000}); } if (#{keyboard_switcher}) { await page.keyboard.press('Meta+k'); await page.locator('#unread-agents-panel:not(.hidden)').waitFor({state:'visible',timeout:15000}); } await target.scrollIntoViewIfNeeded(); await page.screenshot({path:#{File.join(OUTPUT, name).to_json},fullPage:false}); await browser.close(); })().catch(error => { console.error(error); process.exit(1); });
      JS
      system("node", script, exception: true)
    end
    capture.call("personal-assistant-setup-desktop.png", "Desktop Chrome", ".pa-setup", "Choose how FRED should work")
    capture.call("personal-assistant-setup-mobile.png", "iPhone 13", ".pa-setup", "Choose how FRED should work")
    capture.call("personal-assistant-settings-menu-desktop.png", "Desktop Chrome", ".personal-assistant-page", "Choose how FRED should work", open_menu: true)
    capture.call("personal-assistant-settings-menu-mobile.png", "iPhone 13", ".personal-assistant-page", "Choose how FRED should work", open_menu: true)
    request("/personal-assistant/setup", { confirmed: true, model: "gpt-5.6-sol", reasoning_effort: "medium", timezone: "Asia/Jakarta" })
    capture.call("fred-compact-settings-menu-desktop.png", "Desktop Chrome", ".personal-assistant-page", "Opening FRED does not send a model prompt.", open_menu: true)
    capture.call("fred-compact-settings-menu-mobile.png", "iPhone 13", ".personal-assistant-page", "Opening FRED does not send a model prompt.", open_menu: true)
    capture.call("fred-reset-settings-desktop.png", "Desktop Chrome", "#settings-personal-assistant", "Reset FRED", route: "settings")
    capture.call("fred-reset-settings-mobile.png", "iPhone 13", "#settings-personal-assistant", "Reset FRED", route: "settings")
    request("/personal-assistant/reset", { confirmed: true })
    capture.call("fred-onboarding-after-reset-desktop.png", "Desktop Chrome", ".pa-setup", "Choose how FRED should work")
    capture.call("fred-onboarding-after-reset-mobile.png", "iPhone 13", ".pa-setup", "Choose how FRED should work")
    request("/personal-assistant/setup", { confirmed: true, model: "gpt-5.6-sol", reasoning_effort: "medium", timezone: "Asia/Jakarta" })
    capture.call("personal-assistant-ready-desktop.png", "Desktop Chrome", ".pa-ready", "Opening FRED does not send a model prompt.")
    capture.call("personal-assistant-ready-mobile.png", "iPhone 13", ".pa-ready", "Opening FRED does not send a model prompt.")
    request("/personal-assistant/open", {})
    request("/agents", { project_key: "fixture", template_key: "custom", name: "Switcher capture agent", prompt: "Show this agent in the quick switcher.", agent: "codex" })
    capture.call("fred-clean-desktop.png", "Desktop Chrome", ".personal-assistant-page", "FRED")
    capture.call("fred-clean-mobile.png", "iPhone 13", ".personal-assistant-page", "FRED")
    capture.call("fred-switcher-desktop.png", "Desktop Chrome", ".personal-assistant-page", "FRED", open_switcher: true)
    capture.call("fred-switcher-mobile.png", "iPhone 13", ".personal-assistant-page", "FRED", open_switcher: true)
    capture.call("fred-switcher-keyboard-desktop.png", "Desktop Chrome", ".personal-assistant-page", "FRED", keyboard_switcher: true)
    capture.call("agents-without-fred-desktop.png", "Desktop Chrome", ".ui-searchable-collection", "Agents", route: "agents")
  ensure
    Process.kill("TERM", pid) rescue nil
    Process.wait(pid) rescue nil
  end
end
