#!/usr/bin/env ruby
# frozen_string_literal: true

require "fileutils"
require "json"
require "net/http"
require "socket"
require "tmpdir"

require_relative "../lib/hq/domain/file_store"

ROOT = File.expand_path("..", __dir__)
OUTPUT = File.expand_path(ENV.fetch("TYCHO_PERSONAL_ASSISTANT_CAPTURE_OUTPUT", "~/.tycho/artifacts/card-170/fred-reset-settings"))
ACTION_RESULT_OUTPUT = File.expand_path(ENV.fetch("TYCHO_PERSONAL_ASSISTANT_ACTION_RESULT_OUTPUT", "~/.tycho/artifacts/fred-implementation/action-result-desktop.png"))
PORT = TCPServer.open("127.0.0.1", 0) { |server| server.addr[1] }

def request(path, payload = nil)
  request = payload ? Net::HTTP::Post.new(path, "Content-Type" => "application/json") : Net::HTTP::Get.new(path)
  request.body = JSON.generate(payload) if payload
  Net::HTTP.start("127.0.0.1", PORT) { |http| http.request(request) }
end

def wait_for_server
  100.times do
    return if request("/personal-assistant").is_a?(Net::HTTPSuccess)

    sleep 0.1
  rescue Errno::ECONNREFUSED
    sleep 0.1
  end
  raise "Personal Assistant fixture server did not start"
end

Dir.mktmpdir("tycho-pa-capture") do |dir|
  FileUtils.mkdir_p(OUTPUT)
  FileUtils.mkdir_p(File.dirname(ACTION_RESULT_OUTPUT))
  config = File.join(dir, "hq.yml")
  schedules = File.join(dir, "schedules.yml")
  fake_codex = File.join(dir, "fake-codex")
  File.write(schedules, "---\nschedules: []\n")
  File.write(config, <<~YAML)
    ---
    custom_harnesses: []
    harness_catalogs: {}
    groups: {}
    projects:
      - key: fixture
        name: Personal Assistant fixture
        path: #{ROOT}
        harnesses: []
  YAML
  File.write(fake_codex, <<~'RUBY')
    #!/usr/bin/env ruby
    require "json"
    abort "obsolete --full-auto flag" if ARGV.include?("--full-auto")
    proposal = if ARGV.join(" ").include?("Create a fixture agent")
      [{ "type" => "create_agent", "description" => "Create the fixture review agent.", "arguments" => { "project_key" => "fixture", "name" => "FRED fixture agent", "prompt" => "Inspect the fixture project.", "agent" => "codex", "model" => "gpt-5.6-sol", "reasoning_effort" => "medium" } }]
    else
      nil
    end
    payload = {
      "status" => "success", "summary" => "FRED test reply.", "summary_sections" => nil,
      "inquiry" => nil, "attachments" => nil, "action_proposals" => proposal, "memory_handoff" => nil
    }
    output_index = ARGV.index("-o")
    File.write(ARGV[output_index + 1], JSON.generate(payload)) if output_index
    puts JSON.generate("type" => "thread.started", "thread_id" => "fred-capture-#{Process.pid}")
    puts JSON.generate("type" => "item.completed", "item" => { "type" => "agent_message", "text" => JSON.generate(payload) })
  RUBY
  File.chmod(0o755, fake_codex)
  tycho_home = File.join(dir, "tycho-home")
  env = { "TYCHO_HOME" => tycho_home, "TYCHO_CONFIG_PATH" => config, "TYCHO_SYSTEM_PROMPTS_PATH" => File.join(ROOT, "config/system_prompts.yml.example"), "TYCHO_LOGS_ROOT" => File.join(dir, "logs"), "TYCHO_SCHEDULES_PATH" => schedules, "TYCHO_REMOTE_TOKEN" => "", "TYCHO_CODEX_BIN" => fake_codex }
  pid = Process.spawn(env, "bundle", "exec", "bin/tycho", "serve", "--host", "127.0.0.1", "--port", PORT.to_s, chdir: ROOT, out: File.join(dir, "server.log"), err: File.join(dir, "server.log"))
  begin
    wait_for_server
    capture = ->(name, device, selector, expected, route: "personal-assistant", open_menu: false, open_switcher: false, keyboard_switcher: false, reset_fred: false) do
      playwright = ENV.fetch("TYCHO_PLAYWRIGHT_PATH", File.expand_path("node_modules/playwright", ROOT))
      raise "Install deterministic Playwright dependency at #{playwright} or set TYCHO_PLAYWRIGHT_PATH" unless File.directory?(playwright)
      script = File.join(dir, "capture.js")
      File.write(script, <<~JS)
        const { chromium, devices } = require(#{playwright.to_json});
        (async () => { const browser = await chromium.launch({headless:true}); const page = await browser.newPage(devices[#{device.to_json}]); if (#{device.to_json} === 'Desktop Chrome') await page.setViewportSize({ width: 1280, height: 900 }); await page.goto('http://127.0.0.1:#{PORT}/ui##{route}'); const target = page.locator(#{selector.to_json}); await target.waitFor({state:'visible',timeout:15000}); await page.waitForFunction(() => { const boot = document.querySelector('#tycho-boot-shell'); return !boot || getComputedStyle(boot).display === 'none' || getComputedStyle(boot).visibility === 'hidden'; }, null, {timeout:15000}); await page.waitForFunction(() => document.body.innerText.includes(#{expected.to_json}), null, {timeout:15000}); if (#{open_menu}) { await page.locator('#header-more-button').click(); await page.locator('#header-more-panel:not(.hidden) [data-open-settings]').waitFor({state:'visible',timeout:15000}); } if (#{open_switcher}) { await page.locator('[data-agent-switcher]').click(); await page.locator('#unread-agents-panel:not(.hidden)').waitFor({state:'visible',timeout:15000}); } if (#{keyboard_switcher}) { await page.keyboard.press('Meta+k'); await page.locator('#unread-agents-panel:not(.hidden)').waitFor({state:'visible',timeout:15000}); } if (#{reset_fred}) { await page.locator('.pa-danger-zone > summary').click(); await page.locator('[data-reset-personal-assistant]').click(); await page.locator('#confirmation-dialog[open]').waitFor({state:'visible',timeout:15000}); await page.locator('[data-confirmation-accept]').click(); await page.waitForFunction(() => document.body.innerText.includes('Set up FRED'), null, {timeout:15000}); } else { await target.scrollIntoViewIfNeeded(); } await page.screenshot({path:#{File.join(OUTPUT, name).to_json},fullPage:false}); await browser.close(); })().catch(error => { console.error(error); process.exit(1); });
      JS
      system("node", script, exception: true)
    end
    verify_initiate = lambda do
      playwright = ENV.fetch("TYCHO_PLAYWRIGHT_PATH", File.expand_path("node_modules/playwright", ROOT))
      script = File.join(dir, "verify-initiate.js")
      File.write(script, <<~JS)
        const { chromium } = require(#{playwright.to_json});
        (async () => {
          const browser = await chromium.launch({ headless: true });
          const page = await browser.newPage();
          await page.setViewportSize({ width: 1280, height: 1000 });
          await page.goto('http://127.0.0.1:#{PORT}/ui#settings');
          await page.locator('[data-scroll-settings-section="settings-personal-assistant"]').click();
          await page.waitForFunction(() => {
            const panel = document.querySelector('#settings-panel-personal-assistant');
            const section = document.querySelector('#settings-personal-assistant');
            if (!panel || !section) return false;
            const rect = panel.getBoundingClientRect();
            return rect.top >= 0 && rect.top < window.innerHeight && section.getBoundingClientRect().bottom > 0;
          }, null, { timeout: 15000 });
          await page.locator('[data-initiate-personal-assistant]').click();
          await page.locator('.pa-setup').waitFor({ state: 'visible', timeout: 15000 });
          const setupCopy = await page.locator('.pa-setup').innerText();
          if (!setupCopy.includes('Friendly Robot for Execution Dispatcher')) throw new Error('FRED setup did not explain its name and purpose');
          if (setupCopy.includes('Codex found')) throw new Error('FRED setup retained noisy healthy-Codex copy');
          await page.locator('#personal-assistant-setup-form input[name="confirmed"]').check();
          await page.locator('#personal-assistant-setup-form button[type="submit"]').click();
          await page.locator('.pa-recommendations').waitFor({ state: 'visible', timeout: 15000 });
          await page.goto('http://127.0.0.1:#{PORT}/ui#settings');
          const goToFred = page.locator('#settings-personal-assistant a[href="#personal-assistant"]');
          if (await goToFred.count() !== 1) throw new Error('FRED settings did not offer a direct FRED link');
          if (await page.locator('[data-open-personal-assistant]').count()) throw new Error('FRED still requires a manual opening control');
          await goToFred.click();
          await page.locator('.pa-recommendations').waitFor({ state: 'visible', timeout: 15000 });
          if ((await page.locator('.personal-assistant-page').innerText()).includes('Open conversation')) throw new Error('FRED retained opening-conversation ceremony copy');
          const recommendationButtons = page.locator('.pa-recommendations [data-pa-suggestion]');
          if (await recommendationButtons.count() < 3) throw new Error('FRED recommendations did not render as action buttons');
          const firstRecommendation = recommendationButtons.first();
          const recommendationPrompt = await firstRecommendation.getAttribute('data-pa-suggestion');
          await firstRecommendation.click();
          await page.waitForFunction((prompt) => document.querySelector('#composer #prompt-input')?.value === prompt, recommendationPrompt, { timeout: 15000 });
          if ((await page.locator('.personal-assistant-page').innerText()).includes('What FRED can do')) throw new Error('FRED retained its static capability list');
          if (await page.locator('.pa-current-work, #pa-project-starter-form').count()) throw new Error('FRED retained a removed starting surface');
          if (#{(ENV["TYCHO_PERSONAL_ASSISTANT_RECOMMENDATIONS_ONLY"] == "1").to_json}) {
            await page.locator('#growl.hidden').waitFor({ state: 'attached', timeout: 15000 });
            await page.setViewportSize({ width: 1280, height: 900 });
            await page.screenshot({ path: #{File.join(OUTPUT, "fred-recommendations-desktop.png").to_json}, fullPage: false });
            await page.setViewportSize({ width: 390, height: 844 });
            const recommendationBox = await page.locator('.pa-recommendations').boundingBox();
            const composerBox = await page.locator('#composer').boundingBox();
            if (!recommendationBox || recommendationBox.width > 390) throw new Error(`Recommendations overflow the mobile viewport: ${JSON.stringify(recommendationBox)}`);
            if (!composerBox || composerBox.y + composerBox.height > 844) throw new Error(`Composer is not pinned inside the mobile viewport: ${JSON.stringify(composerBox)}`);
            await page.screenshot({ path: #{File.join(OUTPUT, "fred-recommendations-mobile.png").to_json}, fullPage: false });
            await page.goto('http://127.0.0.1:#{PORT}/ui#settings');
            await page.locator('[data-edit-personal-assistant-settings]').click();
            const externalPrompt = page.locator('#personal-assistant-settings-form [name="external_events_prompt"]');
            if (!(await externalPrompt.inputValue()).includes('Yahoo News or MSN')) throw new Error('Settings did not show the default external-event prompt');
            await externalPrompt.fill('Recommend technology and science news with primary-source links.');
            await page.locator('#personal-assistant-settings-form input[name="confirmed"]').check();
            await page.locator('#personal-assistant-settings-form button[type="submit"]').click();
            await page.waitForFunction(() => !document.querySelector('#personal-assistant-settings-form'), null, { timeout: 15000 });
            const saved = await (await page.request.get('http://127.0.0.1:#{PORT}/personal-assistant')).json();
            if (saved.personal_assistant.config.external_events_prompt !== 'Recommend technology and science news with primary-source links.') throw new Error('External-event prompt was not saved');
            await browser.close();
            return;
          }
          await page.locator('#composer #prompt-input').fill('Create a fixture agent');
          await page.locator('#composer button[type="submit"]').click();
          await page.locator('[data-confirm-pa-proposal]').waitFor({ state: 'visible', timeout: 15000 });
          if (!(await page.locator('.pa-inline-action').innerText()).includes('Inspect the fixture project.')) throw new Error('Proposal instruction was not rendered');
          await page.locator('[data-confirm-pa-proposal]').click();
          await page.waitForFunction(() => document.body.innerText.includes('Agent created'), null, { timeout: 15000 });
          const assistantStatus = await (await page.request.get('http://127.0.0.1:#{PORT}/personal-assistant')).json();
          const assistantConversation = await (await page.request.get(`http://127.0.0.1:#{PORT}/agents/${encodeURIComponent(assistantStatus.personal_assistant.active_key)}/conversation`)).json();
          const actionReceipt = assistantConversation.conversation.find((block) => String(block.content || '').startsWith('Tycho completed create_agent.'));
          if (!actionReceipt?.metadata?.personal_assistant_action_proposal_id) throw new Error(`Action receipt metadata missing: ${JSON.stringify(actionReceipt || {})}`);
          const resultLink = page.locator('.pa-action-result a[href^="#agent/"]');
          if (await resultLink.count() !== 1) throw new Error('Created-agent receipt link missing');
          if (!(await page.locator('.pa-action-result').innerText()).includes('Prepare start')) throw new Error('Created-agent next action missing');
          if ((await page.locator('.agent-conversation-scroll').innerText()).includes('Tycho completed create_agent.')) throw new Error('Raw action receipt duplicated the typed result');
          if (await page.locator('.pa-action-feed').count()) throw new Error('Action receipt was not attached to its source reply');
          if (await page.locator('.message-list .pa-inline-action').count() !== 1) throw new Error('Action receipt was not rendered with its source reply');
          if (await page.locator('.personal-assistant-page .message-group, .personal-assistant-page [data-run-summary-id]').count()) throw new Error('FRED chat exposed internal activity or run-summary blocks');
          await page.waitForTimeout(2500);
          await page.locator('.message-list .pa-inline-action').evaluate((card) => card.scrollIntoView({ block: 'start' }));
          await page.screenshot({ path: #{ACTION_RESULT_OUTPUT.to_json}, fullPage: false });
          await resultLink.click();
          await page.waitForFunction(() => document.body.innerText.includes('FRED fixture agent'), null, { timeout: 15000 });
          await page.goto('http://127.0.0.1:#{PORT}/ui#settings');
          await page.locator('[data-edit-personal-assistant-settings]').click();
          if (await page.locator('#personal-assistant-settings-form [name="model"]').inputValue() !== 'gpt-5.6-sol') throw new Error('Settings did not retain model');
          if (await page.locator('#personal-assistant-settings-form [name="timezone"]').inputValue() !== 'Asia/Jakarta') throw new Error('Settings did not retain timezone');
          if (!(await page.locator('#personal-assistant-settings-form [name="external_events_prompt"]').inputValue()).includes('Yahoo News or MSN')) throw new Error('Settings did not show the default external-event prompt');
          const beforeSettings = await (await page.request.get('http://127.0.0.1:#{PORT}/personal-assistant')).json();
          await page.locator('#personal-assistant-settings-form [name="reasoning_effort"]').fill('high');
          await page.locator('#personal-assistant-settings-form [name="external_events_prompt"]').fill('Recommend technology and science news with primary-source links.');
          await page.locator('#personal-assistant-settings-form input[name="confirmed"]').check();
          await page.locator('#personal-assistant-settings-form button[type="submit"]').click();
          await page.waitForFunction(() => !document.querySelector('#personal-assistant-settings-form'), null, { timeout: 15000 });
          const afterSettings = await (await page.request.get('http://127.0.0.1:#{PORT}/personal-assistant')).json();
          if (afterSettings.personal_assistant.active_key !== beforeSettings.personal_assistant.active_key) throw new Error('Editing settings replaced the active conversation');
          if (afterSettings.personal_assistant.config.reasoning_effort !== 'high') throw new Error('Settings change was not saved');
          if (afterSettings.personal_assistant.config.external_events_prompt !== 'Recommend technology and science news with primary-source links.') throw new Error('External-event prompt was not saved');
          await page.goto('http://127.0.0.1:#{PORT}/ui#personal-assistant');
          await page.locator('#composer #prompt-input').fill('Draft survives restart');
          await new Promise((resolve) => setTimeout(resolve, 600));
          await page.goto('http://127.0.0.1:#{PORT}/ui#settings');
          await page.locator('.pa-lifecycle > summary').click();
          await page.locator('[data-restart-personal-assistant]').click();
          await page.locator('#confirmation-dialog[open] [data-confirmation-accept]').click();
          await page.goto('http://127.0.0.1:#{PORT}/ui#personal-assistant');
          await page.waitForFunction(() => document.querySelector('#composer #prompt-input')?.value === 'Draft survives restart', null, { timeout: 15000 });
          await page.reload();
          await page.waitForFunction(() => document.querySelector('#composer #prompt-input')?.value === 'Draft survives restart', null, { timeout: 15000 });
          await page.locator('.pa-continuity > summary').click();
          await page.locator('.pa-continuity-body').waitFor({ state: 'visible', timeout: 15000 });
          if (!(await page.locator('.pa-continuity-body').innerText()).includes('Tracked agents')) throw new Error('Tracked agent context missing');
          await page.locator('[data-open-pa-history]').click();
          await page.locator('.pa-history-entry').waitFor({ state: 'visible', timeout: 15000 });
          await browser.close();
        })().catch(error => { console.error(error); process.exit(1); });
      JS
      system("node", script, exception: true)
    end
    verify_zero_project_entry = lambda do
      zero_port = TCPServer.open("127.0.0.1", 0) { |server| server.addr[1] }
      zero_config = File.join(dir, "zero-projects.yml")
      File.write(zero_config, "---\ncustom_harnesses: []\nharness_catalogs: {}\ngroups: {}\nprojects: []\n")
      zero_env = env.merge("TYCHO_CONFIG_PATH" => zero_config, "TYCHO_LOGS_ROOT" => File.join(dir, "zero-logs"))
      zero_pid = Process.spawn(zero_env, "bundle", "exec", "bin/tycho", "serve", "--host", "127.0.0.1", "--port", zero_port.to_s, chdir: ROOT, out: File.join(dir, "zero-server.log"), err: File.join(dir, "zero-server.log"))
      begin
        100.times do
          response = Net::HTTP.start("127.0.0.1", zero_port) { |http| http.get("/personal-assistant") }
          break if response.is_a?(Net::HTTPSuccess)

          sleep 0.1
        rescue Errno::ECONNREFUSED
          sleep 0.1
        end
        playwright = ENV.fetch("TYCHO_PLAYWRIGHT_PATH", File.expand_path("node_modules/playwright", ROOT))
        script = File.join(dir, "verify-zero-projects.js")
        File.write(script, <<~JS)
          const { chromium } = require(#{playwright.to_json});
          (async () => { const browser = await chromium.launch({headless:true}); const page = await browser.newPage(); await page.goto('http://127.0.0.1:#{zero_port}/ui#personal-assistant'); await page.locator('.pa-setup').waitFor({state:'visible',timeout:15000}); if (await page.locator('.onboarding-page').count()) throw new Error('Project onboarding replaced FRED'); await browser.close(); })().catch(error => { console.error(error); process.exit(1); });
        JS
        system("node", script, exception: true)
      ensure
        Process.kill("TERM", zero_pid) rescue nil
        Process.wait(zero_pid) rescue nil
      end
    end
    if ENV["TYCHO_PERSONAL_ASSISTANT_ZERO_PROJECT_ONLY"] == "1"
      verify_zero_project_entry.call
      exit
    end
    unless ENV["TYCHO_PERSONAL_ASSISTANT_VERIFY_ONLY"] == "1"
      capture.call("personal-assistant-setup-desktop.png", "Desktop Chrome", ".pa-setup", "Set up FRED")
      capture.call("personal-assistant-setup-mobile.png", "iPhone 13", ".pa-setup", "Set up FRED")
      capture.call("personal-assistant-settings-menu-desktop.png", "Desktop Chrome", ".personal-assistant-page", "Set up FRED", open_menu: true)
      capture.call("personal-assistant-settings-menu-mobile.png", "iPhone 13", ".personal-assistant-page", "Set up FRED", open_menu: true)
      capture.call("fred-unconfigured-settings-desktop.png", "Desktop Chrome", "#settings-personal-assistant", "Set up FRED", route: "settings")
      capture.call("fred-unconfigured-settings-mobile.png", "iPhone 13", "#settings-personal-assistant", "Set up FRED", route: "settings")
    end
    verify_initiate.call
    exit if ENV["TYCHO_PERSONAL_ASSISTANT_VERIFY_ONLY"] == "1"
    verify_zero_project_entry.call
    capture.call("fred-compact-settings-menu-desktop.png", "Desktop Chrome", ".personal-assistant-page", "Recommendations", open_menu: true)
    capture.call("fred-compact-settings-menu-mobile.png", "iPhone 13", ".personal-assistant-page", "Recommendations", open_menu: true)
    capture.call("fred-reset-settings-desktop.png", "Desktop Chrome", "#settings-personal-assistant", "Reset FRED", route: "settings")
    capture.call("fred-reset-settings-mobile.png", "iPhone 13", "#settings-personal-assistant", "Reset FRED", route: "settings")
    capture.call("fred-onboarding-after-reset-desktop.png", "Desktop Chrome", "#settings-personal-assistant", "Reset FRED", route: "settings", reset_fred: true)
    capture.call("fred-onboarding-after-reset-mobile.png", "iPhone 13", ".pa-setup", "Set up FRED")
    request("/personal-assistant/setup", { confirmed: true, model: "gpt-5.6-sol", reasoning_effort: "medium", timezone: "Asia/Jakarta" })
    request("/personal-assistant/open", {})
    request("/agents", { project_key: "fixture", template_key: "custom", name: "Switcher capture agent", prompt: "Show this agent in the quick switcher.", agent: "codex" })
    capture.call("fred-clean-desktop.png", "Desktop Chrome", ".personal-assistant-page", "FRED")
    capture.call("fred-clean-mobile.png", "iPhone 13", ".personal-assistant-page", "FRED")
    capture.call("fred-switcher-desktop.png", "Desktop Chrome", ".personal-assistant-page", "FRED", open_switcher: true)
    capture.call("fred-switcher-mobile.png", "iPhone 13", ".personal-assistant-page", "FRED", open_switcher: true)
    capture.call("fred-switcher-keyboard-desktop.png", "Desktop Chrome", ".personal-assistant-page", "FRED", keyboard_switcher: true)
    capture.call("agents-without-fred-desktop.png", "Desktop Chrome", ".ui-searchable-collection", "Agents", route: "agents")
  ensure
    Process.kill("TERM", pid) rescue nil
    Process.wait(pid) rescue nil
  end
end
