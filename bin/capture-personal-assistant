#!/usr/bin/env ruby
# frozen_string_literal: true

require "fileutils"
require "json"
require "net/http"
require "tmpdir"

ROOT = File.expand_path("..", __dir__)
OUTPUT = File.expand_path("~/.tycho/artifacts/card-170")
PORT = 7397

def request(path, payload = nil)
  request = payload ? Net::HTTP::Post.new(path, "Content-Type" => "application/json") : Net::HTTP::Get.new(path)
  request.body = JSON.generate(payload) if payload
  Net::HTTP.start("127.0.0.1", PORT) { |http| http.request(request) }
end

def wait_for_server
  100.times do
    return if request("/personal-assistant").is_a?(Net::HTTPSuccess)

    sleep 0.1
  rescue Errno::ECONNREFUSED
    sleep 0.1
  end
  raise "Personal Assistant fixture server did not start"
end

Dir.mktmpdir("tycho-pa-capture") do |dir|
  FileUtils.mkdir_p(OUTPUT)
  config = File.join(dir, "hq.yml")
  schedules = File.join(dir, "schedules.yml")
  File.write(schedules, "---\nschedules: []\n")
  File.write(config, <<~YAML)
    ---
    custom_harnesses: []
    harness_catalogs: {}
    groups: {}
    projects:
      - key: fixture
        name: Personal Assistant fixture
        path: #{ROOT}
        harnesses: []
  YAML
  env = { "TYCHO_CONFIG_PATH" => config, "TYCHO_SYSTEM_PROMPTS_PATH" => File.join(ROOT, "config/system_prompts.yml.example"), "TYCHO_LOGS_ROOT" => File.join(dir, "logs"), "TYCHO_SCHEDULES_PATH" => schedules }
  pid = Process.spawn(env, "bundle", "exec", "bin/tycho", "serve", "--host", "127.0.0.1", "--port", PORT.to_s, chdir: ROOT, out: File.join(dir, "server.log"), err: File.join(dir, "server.log"))
  begin
    wait_for_server
    capture = ->(name, device, selector, expected) do
      playwright = Dir.glob(File.expand_path("~/.npm/_npx/*/node_modules/playwright")).max_by { |path| File.mtime(path) }
      script = File.join(dir, "capture.js")
      File.write(script, <<~JS)
        const { chromium, devices } = require(#{playwright.to_json});
        (async () => { const browser = await chromium.launch({headless:true}); const page = await browser.newPage(devices[#{device.to_json}]); await page.goto('http://127.0.0.1:#{PORT}/ui#personal-assistant'); await page.locator(#{selector.to_json}).waitFor({state:'visible',timeout:15000}); await page.waitForFunction(() => { const boot = document.querySelector('#tycho-boot-shell'); return !boot || getComputedStyle(boot).display === 'none' || getComputedStyle(boot).visibility === 'hidden'; }, null, {timeout:15000}); await page.waitForFunction(() => !document.querySelector('.tycho-loading-state,.conversation-loading-state'), null, {timeout:15000}); await page.waitForTimeout(750); if (!(await page.locator('body').innerText()).includes(#{expected.to_json})) throw new Error('expected rendered PA text'); await page.screenshot({path:#{File.join(OUTPUT, name).to_json},fullPage:true}); await browser.close(); })().catch(error => { console.error(error); process.exit(1); });
      JS
      system("node", script, exception: true)
    end
    capture.call("personal-assistant-setup-desktop.png", "Desktop Chrome", "#personal-assistant-setup-form", "Set up Personal Assistant")
    request("/personal-assistant/setup", { confirmed: true, model: "gpt-5.6-sol", reasoning_effort: "medium", timezone: "Asia/Jakarta" })
    request("/personal-assistant/open", {})
    request("/personal-assistant/actions/proposals", { proposals: [{ type: "start_agent", description: "Start the selected review agent.", arguments: { agent_key: "fixture-agent" } }] })
    capture.call("personal-assistant-active-desktop.png", "Desktop Chrome", ".personal-assistant-conversation #composer", "Today’s conversation")
    capture.call("personal-assistant-confirmation-desktop.png", "Desktop Chrome", "[data-confirm-pa-proposal]", "Confirm exact action")
    capture.call("personal-assistant-active-mobile.png", "iPhone 13", ".personal-assistant-conversation #composer", "Today’s conversation")
  ensure
    Process.kill("TERM", pid) rescue nil
    Process.wait(pid) rescue nil
  end
end
