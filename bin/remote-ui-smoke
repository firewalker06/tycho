#!/usr/bin/env ruby
# frozen_string_literal: true

require "fileutils"
require "json"
require "net/http"
require "open3"
require "rbconfig"
require "socket"
require "tempfile"
require "tmpdir"
require "timeout"
require "uri"

ROOT = File.expand_path("..", __dir__)

def free_port
  server = TCPServer.new("127.0.0.1", 0)
  server.addr[1]
ensure
  server&.close
end

def write_fixture(dir)
  config_dir = File.join(dir, "config")
  workspace = File.join(dir, "workspace")
  FileUtils.mkdir_p(config_dir)
  FileUtils.mkdir_p(workspace)

  config_path = File.join(config_dir, "hq.yml")
  prompts_path = File.join(config_dir, "system_prompts.yml")
  response_style_path = File.join(config_dir, "response_style.md")
  schedules_path = File.join(config_dir, "schedules.yml")
  File.write(config_path, <<~YAML)
    ---
    projects:
      - key: web
        name: Web
        path: #{workspace.inspect}
        agent: codex
  YAML
  File.write(prompts_path, "---\ncustom: \"Check the workspace.\"\n")
  File.write(schedules_path, "---\nschedules: []\n")
  skill_dir = File.join(workspace, ".agents", "skills", "review")
  FileUtils.mkdir_p(skill_dir)
  File.write(File.join(skill_dir, "SKILL.md"), "# Review\n")
  12.times do |index|
    dir = File.join(workspace, ".agents", "skills", "alpha-#{index.to_s.rjust(2, "0")}")
    FileUtils.mkdir_p(dir)
    File.write(File.join(dir, "SKILL.md"), "# Alpha #{index}\n")
  end

  {
    config_path: config_path,
    prompts_path: prompts_path,
    response_style_path: response_style_path,
    schedules_path: schedules_path,
    logs_dir: File.join(dir, "logs")
  }
end

def wait_for_remote(base_url, log_path)
  uri = URI("#{base_url}/setup")
  Timeout.timeout(15) do
    loop do
      response = Net::HTTP.get_response(uri)
      return if response.is_a?(Net::HTTPSuccess)
    rescue Errno::ECONNREFUSED, Errno::ECONNRESET
      raise "Remote server exited early:\n#{File.read(log_path)}" if @server_pid && !process_alive?(@server_pid)

      sleep 0.1
    end
  end
rescue Timeout::Error
  raise "Remote server did not become reachable:\n#{File.read(log_path)}"
end

def process_alive?(pid)
  Process.kill(0, pid)
  true
rescue Errno::ESRCH
  false
end

def create_agent(base_url)
  uri = URI("#{base_url}/agents")
  request = Net::HTTP::Post.new(uri)
  request["Content-Type"] = "application/json"
  request.body = JSON.generate(
    project_key: "web",
    template_key: "custom",
    name: "Smoke Agent",
    prompt: "Exercise Remote UI composer preservation.",
    agent: "codex"
  )
  response = Net::HTTP.start(uri.hostname, uri.port) { |http| http.request(request) }
  raise "Failed to create smoke agent: #{response.code} #{response.body}" unless response.is_a?(Net::HTTPSuccess)

  JSON.parse(response.body).fetch("agent").fetch("key")
end

def chrome_path
  explicit = ENV["CHROME_PATH"].to_s
  return explicit unless explicit.empty?

  candidates = [
    "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
    "/Applications/Chromium.app/Contents/MacOS/Chromium",
    "/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge"
  ]
  candidates.find { |path| File.executable?(path) }
end

def ensure_browser_prerequisites!
  raise "node is required for Remote UI smoke checks" unless system("node", "--version", out: File::NULL, err: File::NULL)
  raise "npm is required for Remote UI smoke checks" unless system("npm", "--version", out: File::NULL, err: File::NULL)

  browser = chrome_path
  raise "Chrome/Chromium is required; set CHROME_PATH to the browser executable" unless browser

  browser
end

def install_playwright!(node_dir)
  FileUtils.mkdir_p(node_dir)
  package_json = File.join(node_dir, "package.json")
  File.write(package_json, JSON.generate("private" => true, "dependencies" => {}))
  command = [
    "npm", "install",
    "--prefix", node_dir,
    "--no-audit",
    "--fund=false",
    "--ignore-scripts",
    "playwright"
  ]
  out, err, status = Open3.capture3(*command)
  return if status.success?

  raise "Failed to install Playwright for Remote UI smoke check:\n#{out}\n#{err}"
end

def write_smoke_script(path)
  File.write(path, <<~JS)
    const { chromium } = require("playwright");

    async function main() {
      const baseUrl = process.env.TYCHO_REMOTE_UI_URL;
      const agentKey = process.env.TYCHO_REMOTE_UI_AGENT_KEY;
      const chromePath = process.env.CHROME_PATH;
      const draft = "Remote UI smoke draft " + Date.now();
      const errors = [];

      const browser = await chromium.launch({ executablePath: chromePath, headless: true });
      const page = await browser.newPage({ viewport: { width: 390, height: 844 } });
      page.on("console", (message) => {
        if (message.type() === "error") errors.push(message.text());
      });
      page.on("pageerror", (error) => errors.push(error.message));

      try {
        await page.goto(`${baseUrl}/ui#agent/${encodeURIComponent(agentKey)}`, { waitUntil: "networkidle" });
        await page.waitForSelector("#prompt-input", { state: "visible", timeout: 10_000 });
        await page.fill("#prompt-input", draft);
        await page.evaluate(async () => {
          if (typeof refresh !== "function") throw new Error("refresh function is unavailable");
          await refresh({ force: true, forceConversation: true });
        });
        await page.waitForSelector("#prompt-input", { state: "visible", timeout: 10_000 });

        const value = await page.locator("#prompt-input").inputValue();
        if (value !== draft) throw new Error(`Composer draft was not preserved: ${JSON.stringify(value)}`);

        await page.click("#header-more-button");
        await page.waitForSelector("[data-toggle-agent-settings]", { state: "visible", timeout: 10_000 });
        await page.click("[data-toggle-agent-settings]");
        await page.waitForSelector("#agent-settings-panel:not(.hidden)", { state: "visible", timeout: 10_000 });
        const conversationSettings = await page.locator("#agent-settings-panel").innerText();
        if (!conversationSettings.includes(`Agent key\\n${agentKey}`) || !conversationSettings.includes("Response style\\nDisabled")) {
          throw new Error(`Conversation settings are missing key or response style source: ${JSON.stringify(conversationSettings)}`);
        }
        const conversationSettingLabels = await page.locator("#agent-settings-panel .kv > span").allTextContents();
        const sortedConversationSettingLabels = [...conversationSettingLabels].sort((left, right) => left.localeCompare(right));
        if (JSON.stringify(conversationSettingLabels) !== JSON.stringify(sortedConversationSettingLabels)) {
          throw new Error(`Conversation settings are not alphabetical: ${JSON.stringify(conversationSettingLabels)}`);
        }
        if (conversationSettingLabels.includes("Exit")) {
          throw new Error("Conversation settings should not show Exit");
        }

        await page.fill("#prompt-input", "$rev");
        await page.waitForSelector("[data-skill-autocomplete]:not(.hidden)", { state: "visible", timeout: 10_000 });
        if (!(await page.locator("[data-skill-autocomplete-rescan]").isVisible())) {
          throw new Error("Skill autocomplete re-scan command was not visible");
        }
        await page.evaluate(async () => {
          if (typeof refresh !== "function") throw new Error("refresh function is unavailable");
          await refresh({ force: true, forceConversation: true });
        });
        await page.waitForSelector("[data-skill-autocomplete]:not(.hidden)", { state: "visible", timeout: 10_000 });
        const stillAutocompleting = await page.locator("#prompt-input").inputValue();
        if (stillAutocompleting !== "$rev") {
          throw new Error(`Autocomplete draft did not survive refresh: ${JSON.stringify(stillAutocompleting)}`);
        }
        await page.keyboard.press("Tab");
        const autocompletedPrompt = await page.locator("#prompt-input").inputValue();
        if (autocompletedPrompt !== "$review ") {
          throw new Error(`Composer skill autocomplete failed: ${JSON.stringify(autocompletedPrompt)}`);
        }

        await page.fill("#prompt-input", "$");
        await page.waitForSelector("[data-skill-autocomplete]:not(.hidden)", { state: "visible", timeout: 10_000 });
        for (let index = 0; index < 10; index += 1) await page.keyboard.press("ArrowDown");
        const menuScrollTop = await page.locator("[data-skill-autocomplete]").evaluate((element) => element.scrollTop);
        if (menuScrollTop <= 0) {
          throw new Error(`Skill autocomplete did not scroll to highlighted item: ${menuScrollTop}`);
        }

        const dockBox = await page.locator("[data-agent-dock]").boundingBox();
        if (!dockBox || dockBox.y + dockBox.height > 844) {
          throw new Error(`Agent dock is outside mobile viewport: ${JSON.stringify(dockBox)}`);
        }

        await page.goto(`${baseUrl}/ui#project/web/agent/new`, { waitUntil: "networkidle" });
        await page.waitForSelector("#agent-prompt", { state: "visible", timeout: 10_000 });
        await page.fill("#agent-prompt", "$rev");
        await page.waitForSelector("[data-skill-autocomplete]:not(.hidden)", { state: "visible", timeout: 10_000 });
        await page.keyboard.press("Tab");
        const agentPrompt = await page.locator("#agent-prompt").inputValue();
        if (agentPrompt !== "$review ") {
          throw new Error(`Agent form skill autocomplete failed: ${JSON.stringify(agentPrompt)}`);
        }
        const selectedPromptTemplate = await page.locator("#agent-template").inputValue();
        const selectedResponseStyle = await page.locator("#agent-response-style").inputValue();
        if (selectedPromptTemplate !== "custom" || selectedResponseStyle !== "global") {
          throw new Error(`Prompt Template and Response Style are not independent: ${JSON.stringify({ selectedPromptTemplate, selectedResponseStyle })}`);
        }
        if (await page.locator("#quick-agent-fab").isVisible()) {
          throw new Error("Quick Agent header action should be hidden on focused forms");
        }
        const agentNameFontSize = await page.locator("#agent-name").evaluate((element) => Number.parseFloat(getComputedStyle(element).fontSize));
        if (agentNameFontSize < 16) {
          throw new Error(`Mobile form input is below zoom-safe size: ${agentNameFontSize}px`);
        }

        await page.goto(`${baseUrl}/ui#schedule/new?project=web`, { waitUntil: "networkidle" });
        await page.waitForSelector("#schedule-system-message", { state: "visible", timeout: 10_000 });
        const scheduleSystemMessage = await page.locator("#schedule-system-message").inputValue();
        if (!scheduleSystemMessage.includes("did not complete a requested change, answer, commit, review, or deliverable")) {
          throw new Error(`Schedule system message is missing strict no-action guidance: ${JSON.stringify(scheduleSystemMessage)}`);
        }
        if (!scheduleSystemMessage.includes("quiet outcome that suppresses operator unread and push notifications")) {
          throw new Error(`Schedule system message is missing quiet-outcome guidance: ${JSON.stringify(scheduleSystemMessage)}`);
        }

        await page.goto(`${baseUrl}/ui#settings`, { waitUntil: "networkidle" });
        await page.waitForSelector("[data-testid='response-style-action']", { state: "visible", timeout: 10_000 });
        const responseStyleExplanation = await page.locator("[data-testid='response-style-summary']").innerText();
        if (!responseStyleExplanation.includes("shared writing guidance") ||
            !responseStyleExplanation.includes("without changing the task or required output format")) {
          throw new Error(`Response style explanation is incomplete: ${JSON.stringify(responseStyleExplanation)}`);
        }
        if (!responseStyleExplanation.includes("Add response style")) {
          throw new Error(`Missing response style should show an add action: ${JSON.stringify(responseStyleExplanation)}`);
        }
        if (await page.locator("[data-testid='response-style-delete']").count()) {
          throw new Error("Missing response style should not show a remove action");
        }
        await page.click("[data-testid='response-style-action']");
        await page.waitForSelector("#response-style-input", { state: "visible", timeout: 10_000 });
        await page.click("[data-cancel-response-style]");
        await page.waitForSelector("[data-testid='response-style-action']", { state: "visible", timeout: 10_000 });
        await page.click("[data-testid='response-style-action']");
        await page.waitForSelector("#response-style-input", { state: "visible", timeout: 10_000 });
        const responseStyleDraft = "Write with smoke-tested clarity. " + Date.now();
        await page.fill("#response-style-input", responseStyleDraft);
        await page.evaluate(async () => {
          if (typeof refresh !== "function") throw new Error("refresh function is unavailable");
          await refresh({ force: true, forceResponseStyle: true });
        });
        await page.waitForSelector("#response-style-input", { state: "visible", timeout: 10_000 });
        const preservedResponseStyle = await page.locator("#response-style-input").inputValue();
        if (preservedResponseStyle !== responseStyleDraft) {
          throw new Error(`Response style draft was not preserved: ${JSON.stringify(preservedResponseStyle)}`);
        }
        await page.click("[data-testid='response-style-save']");
        await page.waitForFunction(
          () => document.querySelector("[data-testid='response-style-action']")?.textContent.includes("Edit response style") &&
            document.querySelector("[data-testid='response-style-excerpt']") &&
            !document.querySelector("#response-style-input") &&
            document.querySelector("#growl")?.textContent === "Response style saved",
          null,
          { timeout: 10_000 }
        );
        await page.reload({ waitUntil: "networkidle" });
        await page.waitForSelector("[data-testid='response-style-action']", { state: "visible", timeout: 10_000 });
        if (await page.locator("#response-style-input").count()) {
          throw new Error("Configured response style editor should be collapsed by default");
        }
        const responseStyleSummary = await page.locator("[data-testid='response-style-summary']").innerText();
        if (!responseStyleSummary.includes("Edit response style") || !responseStyleSummary.includes(responseStyleDraft)) {
          throw new Error(`Configured response style summary is incomplete: ${JSON.stringify(responseStyleSummary)}`);
        }
        await page.waitForSelector("[data-testid='response-style-delete']", { state: "visible", timeout: 10_000 });
        await page.waitForSelector("[data-testid='response-style-active']", { state: "visible", timeout: 10_000 });
        await page.click("[data-testid='response-style-action']");
        await page.waitForSelector("#response-style-input", { state: "visible", timeout: 10_000 });
        const savedResponseStyle = await page.locator("#response-style-input").inputValue();
        if (savedResponseStyle !== responseStyleDraft) {
          throw new Error(`Response style was not persisted: ${JSON.stringify(savedResponseStyle)}`);
        }

        await page.goto(`${baseUrl}/ui`, { waitUntil: "networkidle" });
        await page.waitForSelector("#quick-agent-fab:not(.hidden)", { state: "visible", timeout: 10_000 });
        await page.click("#quick-agent-fab");
        await page.waitForSelector("#quick-agent-prompt", { state: "visible", timeout: 10_000 });
        await page.fill("#quick-agent-prompt", "$rev");
        await page.waitForSelector("[data-skill-autocomplete]:not(.hidden)", { state: "visible", timeout: 10_000 });
        await page.keyboard.press("Tab");
        const quickPrompt = await page.locator("#quick-agent-prompt").inputValue();
        if (quickPrompt !== "$review ") {
          throw new Error(`Quick Agent skill autocomplete failed: ${JSON.stringify(quickPrompt)}`);
        }
        const quickSubmit = page.locator("#quick-agent-form button[type='submit']");
        if (!(await quickSubmit.isVisible())) {
          throw new Error("Quick Agent primary submit action was not visible");
        }
        const quickSubmitBox = await quickSubmit.boundingBox();
        if (!quickSubmitBox || quickSubmitBox.y + quickSubmitBox.height > 844) {
          throw new Error(`Quick Agent submit action is outside mobile viewport: ${JSON.stringify(quickSubmitBox)}`);
        }

        if (errors.length) throw new Error(`Browser console errors: ${errors.join(" | ")}`);
        console.log("remote-ui-smoke: ok");
      } finally {
        await browser.close();
      }
    }

    main().catch((error) => {
      console.error(error);
      process.exit(1);
    });
  JS
end

browser = ensure_browser_prerequisites!

Dir.mktmpdir("tycho-remote-ui-smoke") do |dir|
  fixture = write_fixture(dir)
  port = free_port
  base_url = "http://127.0.0.1:#{port}"
  log_path = File.join(dir, "remote-server.log")
  env = {
    "TYCHO_CONFIG_PATH" => fixture.fetch(:config_path),
    "TYCHO_SYSTEM_PROMPTS_PATH" => fixture.fetch(:prompts_path),
    "TYCHO_RESPONSE_STYLE_PATH" => fixture.fetch(:response_style_path),
    "TYCHO_SCHEDULES_PATH" => fixture.fetch(:schedules_path),
    "TYCHO_LOGS_ROOT" => fixture.fetch(:logs_dir),
    "TYCHO_REMOTE_TOKEN" => ""
  }

  @server_pid = Process.spawn(
    env,
    RbConfig.ruby, "bin/tycho", "serve", "--host", "127.0.0.1", "--port", port.to_s,
    chdir: ROOT,
    out: [log_path, "w"],
    err: %i[child out],
    pgroup: true
  )

  begin
    wait_for_remote(base_url, log_path)
    agent_key = create_agent(base_url)
    node_dir = File.join(dir, "node")
    install_playwright!(node_dir)
    script = File.join(node_dir, "remote-ui-smoke.js")
    write_smoke_script(script)

    smoke_env = {
      "TYCHO_REMOTE_UI_URL" => base_url,
      "TYCHO_REMOTE_UI_AGENT_KEY" => agent_key,
      "CHROME_PATH" => browser
    }
    command = ["node", script]
    out, err, status = Open3.capture3(smoke_env, *command, chdir: node_dir)
    puts out unless out.empty?
    warn err unless err.empty?
    exit(status.exitstatus || 1) unless status.success?
  ensure
    if @server_pid && process_alive?(@server_pid)
      Process.kill("TERM", -@server_pid)
      Process.wait(@server_pid)
    end
  end
end
