ROOT = File.expand_path("..", __dir__)

def free_port
  server = TCPServer.new("127.0.0.1", 0)
  server.addr[1]
ensure
  server&.close
end

def write_fixture(dir)
  config_dir = File.join(dir, "config")
  workspace = File.join(dir, "workspace")
  FileUtils.mkdir_p(config_dir)
  FileUtils.mkdir_p(workspace)

  config_path = File.join(config_dir, "hq.yml")
  prompts_path = File.join(config_dir, "system_prompts.yml")
  response_style_path = File.join(config_dir, "response_style.md")
  schedules_path = File.join(config_dir, "schedules.yml")
  fake_codex_path = File.join(dir, "fake-codex")
  File.write(config_path, <<~YAML)
    ---
    projects:
      - key: web
        name: Web
        path: #{workspace.inspect}
        agent: codex
  YAML
  File.write(prompts_path, "---\ncustom: \"Check the workspace.\"\n")
  File.write(schedules_path, <<~YAML)
    ---
    schedules:
      - key: smoke
        name: Smoke schedule
        cron: "0 9 * * 1-5"
        target:
          type: agent
          project_key: web
          message: "Exercise scheduled agent controls."
  YAML
  File.write(fake_codex_path, "#!/bin/sh\nexit 0\n")
  File.chmod(0o755, fake_codex_path)
  skill_dir = File.join(workspace, ".agents", "skills", "review")
  FileUtils.mkdir_p(skill_dir)
  File.write(File.join(skill_dir, "SKILL.md"), "# Review\n")
  12.times do |index|
    dir = File.join(workspace, ".agents", "skills", "alpha-#{index.to_s.rjust(2, "0")}")
    FileUtils.mkdir_p(dir)
    File.write(File.join(dir, "SKILL.md"), "# Alpha #{index}\n")
  end

  {
    config_path: config_path,
    prompts_path: prompts_path,
    response_style_path: response_style_path,
    schedules_path: schedules_path,
    fake_codex_path: fake_codex_path,
    logs_dir: File.join(dir, "logs")
  }
end

def wait_for_remote(base_url, log_path)
  uri = URI("#{base_url}/setup")
  Timeout.timeout(15) do
    loop do
      response = Net::HTTP.get_response(uri)
      return if response.is_a?(Net::HTTPSuccess)
    rescue Errno::ECONNREFUSED, Errno::ECONNRESET
      raise "Remote server exited early:\n#{File.read(log_path)}" if @server_pid && !process_alive?(@server_pid)

      sleep 0.1
    end
  end
rescue Timeout::Error
  raise "Remote server did not become reachable:\n#{File.read(log_path)}"
end

def process_alive?(pid)
  Process.kill(0, pid)
  true
rescue Errno::ESRCH
  false
end

def create_agent(base_url)
  uri = URI("#{base_url}/agents")
  request = Net::HTTP::Post.new(uri)
  request["Content-Type"] = "application/json"
  request.body = JSON.generate(
    project_key: "web",
    template_key: "custom",
    name: "Smoke Agent",
    prompt: "Exercise Remote UI composer preservation.",
    agent: "codex"
  )
  response = Net::HTTP.start(uri.hostname, uri.port) { |http| http.request(request) }
  raise "Failed to create smoke agent: #{response.code} #{response.body}" unless response.is_a?(Net::HTTPSuccess)

  JSON.parse(response.body).fetch("agent").fetch("key")
end

def associate_agent_schedule(logs_dir, agent_key)
  agents_path = File.join(logs_dir, "managed_agents.json")
  agents = JSON.parse(File.read(agents_path))
  agent = agents.find { |item| item["key"] == agent_key }
  raise "Failed to find smoke agent #{agent_key.inspect}" unless agent

  agent["schedule_key"] = "smoke"
  agent["template_key"] = "scheduled"
  File.write(agents_path, JSON.pretty_generate(agents))
end

def mark_schedule_daemon_running(logs_dir, pid)
  FileUtils.mkdir_p(logs_dir)
  now = Time.now.iso8601
  File.write(
    File.join(logs_dir, "scheduler_daemon.json"),
    JSON.pretty_generate(
      "pid" => pid,
      "mode" => "daemon",
      "dry_run" => false,
      "interval" => 30,
      "started_at" => now,
      "last_tick_started_at" => now,
      "last_tick_finished_at" => now
    )
  )
end

def chrome_path
  explicit = ENV["CHROME_PATH"].to_s
  return explicit unless explicit.empty?

  candidates = [
    "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
    "/Applications/Chromium.app/Contents/MacOS/Chromium",
    "/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge"
  ]
  candidates.find { |path| File.executable?(path) }
end

def ensure_browser_prerequisites!
  raise "node is required for Remote UI smoke checks" unless system("node", "--version", out: File::NULL, err: File::NULL)
  raise "npm is required for Remote UI smoke checks" unless system("npm", "--version", out: File::NULL, err: File::NULL)

  browser = chrome_path
  raise "Chrome/Chromium is required; set CHROME_PATH to the browser executable" unless browser

  browser
end

def install_playwright!(node_dir)
  FileUtils.mkdir_p(node_dir)
  package_json = File.join(node_dir, "package.json")
  File.write(package_json, JSON.generate("private" => true, "dependencies" => {}))
  command = [
    "npm", "install",
    "--prefix", node_dir,
    "--no-audit",
    "--fund=false",
    "--ignore-scripts",
    "playwright"
  ]
  out, err, status = Open3.capture3(*command)
  return if status.success?

  raise "Failed to install Playwright for Remote UI smoke check:\n#{out}\n#{err}"
end

def write_smoke_script(path)
  File.write(path, <<~JS)
    const { chromium } = require("playwright");
    const fs = require("fs");
    const path = require("path");

    async function main() {
      const baseUrl = process.env.TYCHO_REMOTE_UI_URL;
      const agentKey = process.env.TYCHO_REMOTE_UI_AGENT_KEY;
      const unscheduledAgentKey = `${agentKey}-unscheduled-smoke`;
      const chromePath = process.env.CHROME_PATH;
      const captureDir = process.env.TYCHO_REMOTE_UI_CAPTURE_DIR || "";
      const draft = "Remote UI smoke draft " + Date.now();
      const errors = [];

      if (captureDir) fs.mkdirSync(captureDir, { recursive: true });

      const browser = await chromium.launch({ executablePath: chromePath, headless: true });
      const page = await browser.newPage({ viewport: { width: 390, height: 844 } });
      page.on("console", (message) => {
        if (message.type() === "error") errors.push(message.text());
      });
      page.on("pageerror", (error) => errors.push(error.message));

      async function assertEditorExcludedFromRefresh(selector, label, focusSelector) {
        if (focusSelector) await page.focus(focusSelector);
        const result = await page.evaluate(({ selector, label }) => {
          const editor = document.querySelector(selector);
          if (!editor) return { sameNode: false, sameFocus: false, blurred: false };
          editor.__tychoRefreshProbe = label;
          state.renderedViewHtml = "";
          let blurred = false;
          const control = document.activeElement;
          control?.addEventListener("blur", () => { blurred = true; }, { once: true });
          render({ preserveLiveEditor: true });
          return {
            sameNode: document.querySelector(selector)?.__tychoRefreshProbe === label,
            sameFocus: document.activeElement === control,
            blurred,
          };
        }, { selector, label });
        if (!result.sameNode || !result.sameFocus || result.blurred) throw new Error(`${label} did not remain stable during a polling render: ${JSON.stringify(result)}`);
      }

      try {
        await page.goto(`${baseUrl}/ui`, { waitUntil: "networkidle" });
        await page.waitForSelector("[data-state-key='schedule-now-details']", { state: "visible", timeout: 10_000 });
        const scheduleMenuGeometry = await page.evaluate(() => {
          const details = document.querySelector("[data-state-key='schedule-now-details']");
          details.open = true;
          const rows = Array.from(document.querySelectorAll(".schedule-row"));
          const row = rows.at(-1);
          const menu = row?.querySelector(".schedule-action-menu");
          const popover = menu?.querySelector(".schedule-action-popover");
          const card = row?.closest(".schedule-card");
          if (!menu || !popover || !card) return { found: false };

          menu.open = true;
          const popoverRect = popover.getBoundingClientRect();
          const cardRect = card.getBoundingClientRect();
          const sampleX = popoverRect.left + (popoverRect.width / 2);
          const sampleY = Math.min(popoverRect.bottom - 2, cardRect.bottom + 8);
          const hit = document.elementFromPoint(sampleX, sampleY);
          return {
            found: true,
            popoverBottom: popoverRect.bottom,
            cardBottom: cardRect.bottom,
            cardOverflow: getComputedStyle(card).overflow,
            visibleBeyondCard: popover.contains(hit),
          };
        });
        if (!scheduleMenuGeometry.found ||
            (scheduleMenuGeometry.popoverBottom > scheduleMenuGeometry.cardBottom &&
             !scheduleMenuGeometry.visibleBeyondCard)) {
          throw new Error(`Schedule action menu is clipped by its card: ${JSON.stringify(scheduleMenuGeometry)}`);
        }
        await page.click("#header-more-button");
        await page.waitForSelector("#header-more-panel:not(.hidden)", { state: "visible", timeout: 10_000 });
        await page.evaluate(async () => {
          await refresh({ force: true });
        });
        const headerMoreAfterRefresh = await page.evaluate(() => ({
          open: state.headerMoreOpen,
          expanded: document.querySelector("#header-more-button")?.getAttribute("aria-expanded"),
          visible: !document.querySelector("#header-more-panel")?.classList.contains("hidden"),
        }));
        if (!headerMoreAfterRefresh.open || headerMoreAfterRefresh.expanded !== "true" || !headerMoreAfterRefresh.visible) {
          throw new Error(`Polling refresh closed the Now context menu: ${JSON.stringify(headerMoreAfterRefresh)}`);
        }

        const designSystemPage = await browser.newPage({ viewport: { width: 390, height: 844 } });
        await designSystemPage.goto(`${baseUrl}/design-system`, { waitUntil: "networkidle" });
        const metadataBadgeContract = await designSystemPage.locator(".ds-metadata-badge").evaluateAll((badges) => ({
          count: badges.length,
          metadataKind: badges.every((badge) => badge.getAttribute("data-kind") === "metadata"),
          noStatusIntent: badges.every((badge) => !badge.hasAttribute("data-intent")),
          overflow: document.documentElement.scrollWidth > document.documentElement.clientWidth,
        }));
        if (metadataBadgeContract.count < 6 || !metadataBadgeContract.metadataKind ||
            !metadataBadgeContract.noStatusIntent || metadataBadgeContract.overflow) {
          throw new Error(`Metadata badge preview lost its neutral contract: ${JSON.stringify(metadataBadgeContract)}`);
        }
        if (await designSystemPage.locator(".ds-status").count() < 6) {
          throw new Error("Metadata badge preview no longer demonstrates the separate product status contract");
        }
        if (captureDir) {
          await designSystemPage.screenshot({
            path: path.join(captureDir, "design-system-preview-390x844.png"),
            fullPage: true,
          });
          await designSystemPage.setViewportSize({ width: 768, height: 1024 });
          await designSystemPage.screenshot({
            path: path.join(captureDir, "design-system-preview-768x1024.png"),
            fullPage: true,
          });
          await designSystemPage.setViewportSize({ width: 1440, height: 900 });
          await designSystemPage.screenshot({
            path: path.join(captureDir, "design-system-preview-1440x900.png"),
            fullPage: true,
          });
        }
        await designSystemPage.close();

        if (captureDir) {
          const productMetadataPage = await browser.newPage({ viewport: { width: 1440, height: 900 } });
          await productMetadataPage.goto(`${baseUrl}/ui#project/web`, { waitUntil: "networkidle" });
          await productMetadataPage.waitForSelector("#view > .chip-row .ds-metadata-badge", { state: "visible", timeout: 10_000 });
          const productMetadataContract = await productMetadataPage.locator("#view > .chip-row .ds-metadata-badge").evaluateAll((badges) => ({
            count: badges.length,
            metadataKind: badges.every((badge) => badge.getAttribute("data-kind") === "metadata"),
            noStatusIntent: badges.every((badge) => !badge.hasAttribute("data-intent")),
            overflow: document.documentElement.scrollWidth > document.documentElement.clientWidth,
          }));
          if (!productMetadataContract.count || !productMetadataContract.metadataKind ||
              !productMetadataContract.noStatusIntent || productMetadataContract.overflow) {
            throw new Error(`Project metadata badges lost their product contract: ${JSON.stringify(productMetadataContract)}`);
          }
          await productMetadataPage.screenshot({
            path: path.join(captureDir, "project-metadata-badges-1440x900.png"),
            fullPage: true,
          });
          await productMetadataPage.close();
        }

        const agentsRegressionPage = await browser.newPage({ viewport: { width: 390, height: 844 } });
        const agentsRegressionErrors = [];
        agentsRegressionPage.on("console", (message) => {
          if (message.type() === "error") agentsRegressionErrors.push(message.text());
        });
        agentsRegressionPage.on("pageerror", (error) => agentsRegressionErrors.push(error.message));
        await agentsRegressionPage.goto(`${baseUrl}/ui#agent/${encodeURIComponent(agentKey)}`, { waitUntil: "networkidle" });
        await agentsRegressionPage.waitForSelector("#prompt-input", { state: "visible", timeout: 10_000 });
        await agentsRegressionPage.evaluate(({ key, unscheduledKey }) => {
          const agent = findAgent(key);
          state.agents.push({
            ...agent,
            key: unscheduledKey,
            name: "Unscheduled Smoke Agent",
            schedule_key: null,
            template_key: "custom",
          });
          navigate({ type: "tab", tab: "agents" });
        }, { key: agentKey, unscheduledKey: unscheduledAgentKey });
        await agentsRegressionPage.waitForTimeout(100);
        if (agentsRegressionErrors.length) {
          throw new Error(`Agents view browser errors: ${agentsRegressionErrors.join(" | ")}`);
        }
        await agentsRegressionPage.waitForSelector(`.agent-row[data-open-agent='${unscheduledAgentKey}']`, { state: "visible", timeout: 10_000 });
        await agentsRegressionPage.goto(`${baseUrl}/ui#agent/${encodeURIComponent(agentKey)}`, { waitUntil: "networkidle" });
        await agentsRegressionPage.waitForSelector("#prompt-input", { state: "visible", timeout: 10_000 });
        await agentsRegressionPage.click("#header-mark");
        await agentsRegressionPage.waitForSelector("#unread-agent-search", { state: "visible", timeout: 10_000 });
        await agentsRegressionPage.waitForFunction(
          () => document.activeElement === document.querySelector("#unread-agent-search"),
          null,
          { timeout: 10_000 }
        );
        await agentsRegressionPage.locator("#unread-agent-search").evaluate((input) => { input.__tychoSearchNodeProbe = true; });
        await agentsRegressionPage.fill("#unread-agent-search", "unscheduled");
        const switcherSearchNodeStable = await agentsRegressionPage.locator("#unread-agent-search").evaluate((input) => input.__tychoSearchNodeProbe === true);
        if (!switcherSearchNodeStable) throw new Error("Agent switcher search replaced its focused input while typing");
        await agentsRegressionPage.waitForSelector(`[data-open-agent='${unscheduledAgentKey}']`, { state: "visible", timeout: 10_000 });
        if (await agentsRegressionPage.locator(".switcher-agent-row").count() !== 1) {
          throw new Error("Agent switcher search did not filter the agent list");
        }
        await agentsRegressionPage.press("#unread-agent-search", "Escape");
        if (await agentsRegressionPage.locator("#unread-agent-search").inputValue() !== "" || await agentsRegressionPage.locator(".switcher-agent-row").count() !== 2) {
          throw new Error("Escape did not clear the agent switcher search");
        }
        await agentsRegressionPage.fill("#unread-agent-search", "unscheduled");
        await agentsRegressionPage.click("[data-clear-unread-agent-search]");
        if (await agentsRegressionPage.locator("#unread-agent-search").inputValue() !== "" || await agentsRegressionPage.locator(".switcher-agent-row").count() !== 2) {
          throw new Error("Clear search did not restore the agent switcher list");
        }
        await agentsRegressionPage.press("#unread-agent-search", "Escape");
        await agentsRegressionPage.waitForSelector("#unread-agents-panel", { state: "hidden", timeout: 10_000 });
        await agentsRegressionPage.waitForFunction(
          () => document.activeElement === document.querySelector("#header-mark"),
          null,
          { timeout: 10_000 }
        );

        await agentsRegressionPage.evaluate(() => navigate({ type: "tab", tab: "agents" }));
        await agentsRegressionPage.waitForSelector("[data-agent-sort-menu] > summary", { state: "visible", timeout: 10_000 });
        await agentsRegressionPage.click("[data-agent-sort-menu] > summary");
        await agentsRegressionPage.waitForFunction(
          () => Boolean(document.activeElement?.dataset?.agentSortChoice),
          null,
          { timeout: 10_000 }
        );
        const firstSortChoice = await agentsRegressionPage.evaluate(() => document.activeElement?.dataset?.agentSortChoice);
        await agentsRegressionPage.keyboard.press("ArrowDown");
        const secondSortChoice = await agentsRegressionPage.evaluate(() => document.activeElement?.dataset?.agentSortChoice);
        if (!secondSortChoice || secondSortChoice === firstSortChoice) {
          throw new Error("Agent sort menu ArrowDown did not move focus");
        }
        await agentsRegressionPage.keyboard.press("Escape");
        await agentsRegressionPage.waitForFunction(
          () => (
            !document.querySelector("[data-agent-sort-menu]")?.open &&
            document.activeElement === document.querySelector("[data-agent-sort-menu] > summary")
          ),
          null,
          { timeout: 10_000 }
        );
        await agentsRegressionPage.close();

        const prContextPage = await browser.newPage({ viewport: { width: 390, height: 844 } });
        await prContextPage.goto(`${baseUrl}/ui#agent/${encodeURIComponent(agentKey)}`, { waitUntil: "networkidle" });
        await prContextPage.waitForSelector("#prompt-input", { state: "visible", timeout: 10_000 });
        await prContextPage.evaluate((key) => {
          const agent = findAgent(key);
          agent.attachments = [
            ...(agent.attachments || []),
            { kind: "pull_request", title: "Example PR", url: "https://github.com/example/web/pull/123" },
          ];
          state.renderedViewHtml = "";
          render();
        }, agentKey);
        await prContextPage.click("#header-more-button");
        await prContextPage.waitForSelector(`[data-open-agent-pr-diffs='${agentKey}']`, { state: "visible", timeout: 10_000 });
        await prContextPage.click(`[data-open-agent-pr-diffs='${agentKey}']`);
        await prContextPage.waitForSelector(".agent-pr-diff-shell", { state: "visible", timeout: 10_000 });
        await prContextPage.waitForSelector(".agent-pr-diff-shell .empty-state", { state: "visible", timeout: 10_000 });
        await prContextPage.close();

        await page.goto(`${baseUrl}/ui#agent/${encodeURIComponent(agentKey)}`, { waitUntil: "networkidle" });
        await page.waitForSelector("#prompt-input", { state: "visible", timeout: 10_000 });
        await page.waitForSelector("#header-schedule-menu:not(.hidden)", { state: "visible", timeout: 10_000 });
        const scheduleHeaderGeometry = await page.evaluate(() => {
          const scheduleTrigger = document.querySelector("[data-header-schedule-menu] > summary").getBoundingClientRect();
          const contextTrigger = document.querySelector("#header-more-button").getBoundingClientRect();
          return {
            scheduleRight: scheduleTrigger.right,
            contextLeft: contextTrigger.left,
            topDelta: Math.abs(scheduleTrigger.top - contextTrigger.top),
          };
        });
        if (scheduleHeaderGeometry.scheduleRight > scheduleHeaderGeometry.contextLeft || scheduleHeaderGeometry.topDelta > 1) {
          throw new Error(`Schedule menu is not beside the page context: ${JSON.stringify(scheduleHeaderGeometry)}`);
        }
        const scheduleStatusColors = await page.evaluate((key) => {
          const agent = findAgent(key);
          agent.last_result = "no action";
          agent.status = "succeeded";
          state.renderedViewHtml = "";
          render();
          const comparison = document.createElement("span");
          comparison.className = "pill info";
          document.body.append(comparison);
          const iconColor = getComputedStyle(document.querySelector("[data-header-schedule-menu] > summary")).color;
          const labelColor = getComputedStyle(comparison).color;
          comparison.remove();
          return { iconColor, labelColor };
        }, agentKey);
        if (scheduleStatusColors.iconColor !== scheduleStatusColors.labelColor) {
          throw new Error(`Schedule icon does not match no-action status: ${JSON.stringify(scheduleStatusColors)}`);
        }
        await page.evaluate(() => navigate({ type: "tab", tab: "agents" }));
        await page.waitForSelector(".agent-row[data-open-agent]", { state: "visible", timeout: 10_000 });
        const scheduledAgentListStatus = await page.evaluate((key) => {
          const row = Array.from(document.querySelectorAll(".agent-row[data-open-agent]")).find((item) => item.dataset.openAgent === key);
          const icon = row?.querySelector(".status-mark");
          const label = row?.querySelector(".pill.info");
          return {
            found: Boolean(row && icon && label),
            scheduleIcon: Boolean(icon?.querySelector('path[d="M8 2v4"]')),
            iconColor: icon ? getComputedStyle(icon).color : "",
            labelColor: label ? getComputedStyle(label).color : "",
          };
        }, agentKey);
        if (!scheduledAgentListStatus.found || !scheduledAgentListStatus.scheduleIcon || scheduledAgentListStatus.iconColor !== scheduledAgentListStatus.labelColor) {
          throw new Error(`Scheduled agent list icon does not match no-action status: ${JSON.stringify(scheduledAgentListStatus)}`);
        }
        await page.evaluate((key) => {
          scheduleForAgent(findAgent(key)).status = "stopped";
          state.renderedViewHtml = "";
          render();
        }, agentKey);
        const stoppedAgentListIcon = await page.evaluate((key) => {
          const row = Array.from(document.querySelectorAll(".agent-row[data-open-agent]")).find((item) => item.dataset.openAgent === key);
          const icon = row?.querySelector(".status-mark");
          return { found: Boolean(icon), failClass: icon?.classList.contains("fail") };
        }, agentKey);
        if (!stoppedAgentListIcon.found || !stoppedAgentListIcon.failClass) {
          throw new Error(`Stopped schedule agent-list icon is not red: ${JSON.stringify(stoppedAgentListIcon)}`);
        }
        await page.evaluate((key) => {
          scheduleForAgent(findAgent(key)).status = "scheduled";
          state.renderedViewHtml = "";
          render();
        }, agentKey);
        await page.evaluate((key) => navigate({ type: "agent", key }), agentKey);
        await page.waitForSelector("#prompt-input", { state: "visible", timeout: 10_000 });
        const stoppedScheduleColors = await page.evaluate((key) => {
          const agent = findAgent(key);
          const schedule = scheduleForAgent(agent);
          schedule.status = "stopped";
          state.renderedViewHtml = "";
          render();
          const comparison = document.createElement("span");
          comparison.className = "pill fail";
          document.body.append(comparison);
          const control = document.querySelector("[data-header-schedule-menu]");
          const result = {
            failClass: control?.classList.contains("fail"),
            iconColor: getComputedStyle(control?.querySelector("summary")).color,
            stoppedColor: getComputedStyle(comparison).color,
          };
          comparison.remove();
          return result;
        }, agentKey);
        if (!stoppedScheduleColors.failClass || stoppedScheduleColors.iconColor !== stoppedScheduleColors.stoppedColor) {
          throw new Error(`Stopped schedule header icon is not red: ${JSON.stringify(stoppedScheduleColors)}`);
        }
        await page.evaluate((key) => {
          scheduleForAgent(findAgent(key)).status = "scheduled";
          state.renderedViewHtml = "";
          render();
        }, agentKey);
        await page.click("[data-header-schedule-menu] > summary");
        await page.waitForSelector("[data-header-schedule-menu] [data-schedule-action='run']", { state: "visible", timeout: 10_000 });
        await page.waitForSelector("[data-header-schedule-menu] [data-schedule-action='pause']", { state: "visible", timeout: 10_000 });
        if (!(await page.locator("[data-header-schedule-menu] [data-schedule-action='run'] path[d='M19 18h3']").count())) {
          throw new Error("Header Run now action does not use the Lucide sport-shoe icon");
        }
        await page.click("[data-header-schedule-menu] [data-schedule-action='pause']");
        await page.waitForSelector("[data-header-schedule-menu] [data-schedule-action='resume']", { state: "attached", timeout: 10_000 });
        await page.click("[data-header-schedule-menu] > summary");
        await page.waitForSelector("[data-header-schedule-menu] [data-schedule-action='resume']", { state: "visible", timeout: 10_000 });
        await page.click("[data-header-schedule-menu] > summary");
        await page.fill("#prompt-input", draft);
        await page.evaluate(async () => {
          if (typeof refresh !== "function") throw new Error("refresh function is unavailable");
          await refresh({ force: true, forceConversation: true });
        });
        await page.waitForSelector("#prompt-input", { state: "visible", timeout: 10_000 });

        const value = await page.locator("#prompt-input").inputValue();
        if (value !== draft) throw new Error(`Composer draft was not preserved: ${JSON.stringify(value)}`);
        await assertEditorExcludedFromRefresh("#composer:not(.composer-full-screen)", "Inline conversation form", "#prompt-input");

        const expandButtonGeometry = await page.locator(".composer-full-screen-button").evaluate((button) => {
          const control = button.getBoundingClientRect();
          const icon = button.querySelector(".ui-icon").getBoundingClientRect();
          const style = getComputedStyle(button);
          return {
