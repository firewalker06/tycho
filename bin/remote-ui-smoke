            hash,
            projectKey: parsed.key,
            agentKey: parsed.backTo?.key,
          };
        });
        if (scopedDiffRouteContract.projectKey !== "vps/welcome" ||
            scopedDiffRouteContract.agentKey !== "vps/welcome-agent-fixture") {
          throw new Error(`Scoped project diff route lost its remote owner: ${JSON.stringify(scopedDiffRouteContract)}`);
        }
        const mermaidScriptsBefore = await page.locator('script[src*="/mermaid@"]').count();
        if (mermaidScriptsBefore !== 0) {
          throw new Error("Mermaid loaded before any Mermaid diagram was present");
        }

        await page.evaluate(() => {
          state.attachmentDetails["smoke-html-preview"] = {
            id: "smoke-html-preview",
            type: "file",
            format: "html",
            title: "Interactive HTML smoke lesson",
            path: "/tmp/interactive-smoke-lesson.html",
            content: [
              "<!doctype html><html><head>",
              "<link rel='stylesheet' href='../assets/lesson.css'>",
              "<script defer src='../assets/lesson.js'></" + "script>",
              "</head><body>",
              "<h1>Interactive lesson</h1>",
              "<button id='answer' type='button'>Reveal answer</button>",
              "<p id='result'>Waiting</p>",
              "</body></html>",
            ].join(""),
            preview_assets: {
              "../assets/lesson.css": "data:text/css;base64," + btoa("body { color: rgb(12, 34, 56); }"),
              "../assets/lesson.js": "data:application/javascript;base64," + btoa([
                "document.querySelector('#answer').addEventListener('click', () => {",
                "document.querySelector('#result').textContent = 'Correct';",
                "});",
              ].join("")),
            },
          };
          replaceView(attachmentViewerHtml("smoke-html-preview"));
        });
        const htmlFrame = page.frameLocator(".html-attachment-frame");
        await htmlFrame.locator("h1").waitFor({ state: "visible", timeout: 10_000 });
        await htmlFrame.locator("#answer").click();
        const htmlResult = await htmlFrame.locator("#result").textContent();
        if (htmlResult !== "Correct") {
          throw new Error(`Sandboxed HTML interaction failed: ${JSON.stringify(htmlResult)}`);
        }
        const htmlColor = await htmlFrame.locator("body").evaluate((body) => getComputedStyle(body).color);
        if (htmlColor !== "rgb(12, 34, 56)") {
          throw new Error(`Sandboxed HTML shared asset styling failed: ${JSON.stringify(htmlColor)}`);
        }
        const htmlSandbox = await page.locator(".html-attachment-frame").getAttribute("sandbox");
        if (htmlSandbox.includes("allow-same-origin")) {
          throw new Error(`HTML attachment sandbox exposed Tycho's origin: ${htmlSandbox}`);
        }

        await page.evaluate(async () => {
          await ensureMarkdownParserLoaded();
          replaceView(renderMarkdown([
            "```mermaid",
            "flowchart LR",
            "  A[HTML attachment] --> B[Visible lesson]",
            "```",
          ].join("\\n")));
        });
        await page.waitForSelector(".mermaid svg", { state: "visible", timeout: 20_000 });
        const mermaidContract = await page.evaluate(() => ({
          scripts: document.querySelectorAll('script[src*="/mermaid@"]').length,
          processed: document.querySelector(".mermaid")?.dataset.processed,
          svg: Boolean(document.querySelector(".mermaid svg")),
        }));
        if (mermaidContract.scripts !== 1 || mermaidContract.processed !== "true" || !mermaidContract.svg) {
          throw new Error(`Mermaid rendering contract failed: ${JSON.stringify(mermaidContract)}`);
        }

        await page.evaluate(async () => {
          Object.defineProperty(navigator, "clipboard", {
            configurable: true,
            value: {
              writeText: async (value) => {
                window.__smokeCopiedMarkdownCode = value;
              },
            },
          });
          window.__smokeMarkdownCodeSource = [
            "```javascript",
            "const same = true;",
            "```",
            "```javascript",
            "const same = true;",
            "```",
            "```mermaid",
            "flowchart LR",
            "  A[Copy source] --> B[Still a diagram]",
            "```",
          ].join("\\n");
          window.__smokeMarkdownRender = render;
          render = () => replaceView(renderMarkdown(window.__smokeMarkdownCodeSource, { menuScope: "smoke-markdown-code" }));
          render();
        });
        await page.waitForSelector(".mermaid svg", { state: "visible", timeout: 20_000 });
        const markdownCodeMenus = await page.locator("[data-toggle-markdown-code-menu]").count();
        if (markdownCodeMenus !== 3) {
          throw new Error(`Markdown code blocks did not get independent menus: ${markdownCodeMenus}`);
        }
        await page.click('[data-toggle-markdown-code-menu="markdown-code:smoke-markdown-code:1"]');
        const codeMenuContract = await page.evaluate(() => ({
          openMenus: document.querySelectorAll(".markdown-code-menu-popover").length,
          copyLabel: document.querySelector(".markdown-code-menu-popover [role='menuitem'] strong")?.textContent?.trim(),
        }));
        if (codeMenuContract.openMenus !== 1 || codeMenuContract.copyLabel !== "Copy code") {
          throw new Error(`Markdown code menu did not open independently: ${JSON.stringify(codeMenuContract)}`);
        }
        await page.click("[data-close-markdown-code-menu]");
        const copiedMarkdownCode = await page.evaluate(() => window.__smokeCopiedMarkdownCode);
        if (copiedMarkdownCode !== "const same = true;\\n") {
          throw new Error(`Markdown code copy lost raw source: ${JSON.stringify(copiedMarkdownCode)}`);
        }
        await page.evaluate(() => {
          navigator.clipboard.writeText = async () => { throw new Error("clipboard blocked"); };
        });
        await page.click('[data-toggle-markdown-code-menu="markdown-code:smoke-markdown-code:2"]');
        await page.click("[data-close-markdown-code-menu]");
        await page.waitForSelector(".growl.fail", { state: "visible", timeout: 10_000 });
        const failedCodeCopy = await page.locator(".growl.fail").textContent();
        if (failedCodeCopy !== "Copy failed") {
          throw new Error(`Markdown code copy failure feedback was unclear: ${JSON.stringify(failedCodeCopy)}`);
        }
        await page.evaluate(() => {
          render = window.__smokeMarkdownRender;
          state.renderedViewHtml = "";
          render();
        });

        await page.evaluate(() => {
          state.renderedViewHtml = "";
          render();
        });
        const pollSchedulerContract = await page.evaluate(async (fallbackAgentKey) => {
          const savedHash = location.hash;
          const savedSetup = state.setup;
          const savedServers = state.servers;
          const savedFailureCount = state.failureCount;
          const savedLastShellUpdatedAt = state.lastShellUpdatedAt;
          const originalFetch = window.fetch;
          let catalogReads = 0;
          window.fetch = (...args) => {
            const input = args[0];
            const url = new URL(typeof input === "string" ? input : input.url, location.href);
            const method = String(args[1]?.method || input?.method || "GET").toUpperCase();
            if (method === "GET" && url.pathname === "/servers/resources") catalogReads += 1;
            return originalFetch(...args);
          };

          try {
            const idleAgent = state.agents.find((agent) => !agent.running) || findAgent(fallbackAgentKey);
            state.setup = {
              ...(state.setup || {}),
              refresh_intervals: {
                ...(state.setup?.refresh_intervals || {}),
                idle_ms: 100,
              },
            };
            state.servers = state.servers.map((server) => ({
              ...server,
              status: "online",
              stale: false,
              refreshing: false,
            }));
            state.failureCount = 0;
            history.replaceState(null, "", routeHash({ type: "agent", key: idleAgent.key }));
            const conversationDelay = pollDelay();
            history.replaceState(null, "", savedHash || "#now");
            state.lastShellUpdatedAt = new Date();
            clearTimeout(state.timer);
            state.timer = null;
            schedule(20);
            await new Promise((resolve) => setTimeout(resolve, 900));
            const timerActive = await new Promise((resolve) => {
              const deadline = Date.now() + 1_000;
              const check = () => {
                if (state.timer) return resolve(true);
                if (Date.now() >= deadline) return resolve(false);
                setTimeout(check, 10);
              };
              check();
            });
            return {
              catalogReads,
              conversationDelay,
              timerActive,
            };
          } finally {
            window.fetch = originalFetch;
            history.replaceState(null, "", savedHash || "#now");
            state.setup = savedSetup;
            state.servers = savedServers;
            state.failureCount = savedFailureCount;
            state.lastShellUpdatedAt = savedLastShellUpdatedAt;
            clearTimeout(state.timer);
            state.timer = null;
            schedule();
          }
        }, agentKey);
        if (pollSchedulerContract.catalogReads < 3 ||
            !pollSchedulerContract.timerActive ||
            pollSchedulerContract.conversationDelay !== 5_000) {
          throw new Error(`Remote UI polling did not remain scheduled or use the Conversation interval: ${JSON.stringify(pollSchedulerContract)}`);
        }
        const formPollQuietContract = await page.evaluate(async () => {
          const originalFetch = window.fetch;
          const savedDeferredUntil = state.pollDeferredUntil;
          let catalogReads = 0;
          window.fetch = (...args) => {
            const input = args[0];
            const url = new URL(typeof input === "string" ? input : input.url, location.href);
            const method = String(args[1]?.method || input?.method || "GET").toUpperCase();
            if (method === "GET" && url.pathname === "/servers/resources") catalogReads += 1;
            return originalFetch(...args);
          };

          const form = document.createElement("form");
          const input = document.createElement("textarea");
          form.append(input);
          document.body.append(form);
          const outsideInput = document.createElement("input");
          document.body.append(outsideInput);

          try {
            clearTimeout(state.timer);
            state.timer = null;
            state.pollDeferredUntil = 0;
            schedule(20);
            input.value = "typing";
            input.dispatchEvent(new Event("input", { bubbles: true }));
            const initialQuietRemaining = formPollQuietRemaining();
