                return new Response(JSON.stringify({ error: "Fixture update failure" }), {
                  status: 500,
                  headers: { "Content-Type": "application/json" },
                });
              }
              return new Response(JSON.stringify({ update: { updated: true }, restarting: true }), {
                status: 202,
                headers: { "Content-Type": "application/json" },
              });
            }
            return fixtureFetch(input, init);
