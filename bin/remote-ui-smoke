        await page.click("[data-workspace-file='docs/guide.md']");
        await page.waitForSelector(".workspace-text-preview", { state: "visible", timeout: 10_000 });
        const previewContract = await page.evaluate(() => ({
          route: parseRoute(),
          content: document.querySelector(".workspace-text-preview")?.textContent,
          focusable: document.querySelector(".workspace-text-preview")?.tabIndex,
        }));
        if (previewContract.route.path !== "docs" || previewContract.route.file !== "docs/guide.md" ||
            !previewContract.content?.includes("Read-only preview") || previewContract.focusable !== 0) {
          throw new Error(`Workspace text preview contract failed: ${JSON.stringify(previewContract)}`);
        }
        if (captureDir) await page.screenshot({ path: path.join(captureDir, "workspace-preview-desktop.png"), fullPage: true });

        await page.goBack();
