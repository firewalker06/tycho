        if (mobileContract.overflow || !mobileContract.previewVisible || mobileContract.columns.split(" ").length !== 1) {
          throw new Error(`Workspace mobile layout failed: ${JSON.stringify(mobileContract)}`);
        }
        if (captureDir) await page.screenshot({ path: path.join(captureDir, "workspace-browser-mobile.png"), fullPage: true });

        await page.click("[data-workspace-directory='']");
        await page.waitForSelector("[data-workspace-file='binary.dat']", { state: "visible", timeout: 10_000 });
        await page.click("[data-workspace-file='binary.dat']");
        await page.waitForFunction(() => document.querySelector(".workspace-preview-pane")?.textContent.includes("Binary file"));
        if (!(await page.locator(".workspace-preview-pane").innerText()).includes("Binary file")) {
          throw new Error("Workspace binary state was not visible");
        }
        await page.click("[data-workspace-file='large.txt']");
        await page.waitForFunction(() => document.querySelector(".workspace-preview-pane")?.textContent.includes("File too large"));

        const workspaceRoutePattern = "**/projects/web/workspace?*";
        await page.route(workspaceRoutePattern, async (route) => {
          const requestUrl = new URL(route.request().url());
          if (requestUrl.searchParams.get("path") === "slow") await new Promise((resolve) => setTimeout(resolve, 250));
          await route.continue();
        });
        await page.evaluate(() => {
          delete state.projectWorkspaces[projectWorkspaceKey("web", "slow")];
          delete state.projectWorkspaces[projectWorkspaceKey("web", "fast")];
          navigate({ type: "projectWorkspace", key: "web", path: "slow", file: "" });
        });
        await page.waitForTimeout(30);
        await page.evaluate(() => navigate({ type: "projectWorkspace", key: "web", path: "fast", file: "" }));
        await page.waitForSelector("[data-workspace-file='fast/fast.txt']", { state: "visible", timeout: 10_000 });
        await page.waitForTimeout(300);
        const raceContract = await page.evaluate(() => ({
          route: parseRoute(),
          slowVisible: Boolean(document.querySelector("[data-workspace-file='slow/slow.txt']")),
          fastVisible: Boolean(document.querySelector("[data-workspace-file='fast/fast.txt']")),
        }));
        await page.unroute(workspaceRoutePattern);
        if (raceContract.route.path !== "fast" || raceContract.slowVisible || !raceContract.fastVisible) {
          throw new Error(`Workspace race-safe navigation failed: ${JSON.stringify(raceContract)}`);
        }
        const unexpectedErrors = errors.slice(consoleErrorStart).filter((message) =>
          !message.includes("status of 415") && !message.includes("status of 413"));
        errors.splice(consoleErrorStart, errors.length - consoleErrorStart, ...unexpectedErrors);
      }

      try {
        await page.goto(`${baseUrl}/ui`, { waitUntil: "networkidle" });
        await assertNowStatusIcons();
        if (skillsOnly) {
          await page.goto(`${baseUrl}/ui#settings`, { waitUntil: "networkidle" });
          await page.waitForSelector("#settings-skills", { state: "visible", timeout: 10_000 });
          await assertSkillInstallation();
          if (errors.length) throw new Error(`Browser console errors: ${errors.join(" | ")}`);
          console.log("remote-ui-skill-smoke: ok");
          return;
        }
        await assertProjectWorkspaceBrowser();
        await page.goto(`${baseUrl}/ui`, { waitUntil: "networkidle" });
        const scopedDiffRouteContract = await page.evaluate(() => {
          const source = {
            type: "projectDiff",
            key: "vps/welcome",
            scope: "worktree",
            backTo: { type: "agent", key: "vps/welcome-agent-fixture" },
          };
