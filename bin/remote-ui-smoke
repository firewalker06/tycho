              !active.href.includes(`#agent/${agentKey}`)) {
            throw new Error(`Active notification target is not openable: ${JSON.stringify(active)}`);
          }
          const readState = await page.evaluate(async () => (await (await fetch("/notifications/notification-active")).json()).notification.read_at);
