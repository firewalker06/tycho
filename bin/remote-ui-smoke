        await page.click("#quick-agent-fab");
        await page.waitForSelector("#quick-agent-prompt", { state: "visible", timeout: 10_000 });
        await page.click("[data-quick-agent-toggle]");
        await page.evaluate(() => quickAgentRerender({ effort: "high", advancedOpen: true }));
        await page.waitForSelector("#quick-agent-effort", { state: "visible", timeout: 10_000 });
        const initialQuickEffort = await page.locator("#quick-agent-effort").inputValue();
        if (initialQuickEffort !== "high") {
          throw new Error(`Quick Agent effort fixture did not inherit the project default: ${JSON.stringify(initialQuickEffort)}`);
        }
        await page.selectOption("#quick-agent-effort", "");
        const changedQuickEffort = await page.locator("#quick-agent-effort").inputValue();
        const changedQuickPill = await page.locator(".quick-agent-pill").textContent();
        if (changedQuickEffort !== "" || changedQuickPill.includes("high")) {
          throw new Error(`Quick Agent effort change did not update its visible value: ${JSON.stringify({ changedQuickEffort, changedQuickPill })}`);
        }
        await page.fill("#quick-agent-prompt", "$rev");
        await page.waitForSelector("[data-skill-autocomplete]:not(.hidden)", { state: "visible", timeout: 10_000 });
        await page.waitForSelector("[data-skill-autocomplete-index]", { state: "visible", timeout: 10_000 });
        await page.press("#quick-agent-prompt", "Tab");
        const quickPrompt = await page.locator("#quick-agent-prompt").inputValue();
        if (quickPrompt !== "$review ") {
          throw new Error(`Quick Agent skill autocomplete failed: ${JSON.stringify(quickPrompt)}`);
        }
        const quickSubmit = page.locator("#quick-agent-form button[type='submit']");
        if (!(await quickSubmit.isVisible())) {
          throw new Error("Quick Agent primary submit action was not visible");
        }
        const quickSubmitBox = await quickSubmit.boundingBox();
        if (!quickSubmitBox || quickSubmitBox.y + quickSubmitBox.height > 844) {
          throw new Error(`Quick Agent submit action is outside mobile viewport: ${JSON.stringify(quickSubmitBox)}`);
        }

        await page.evaluate(() => closeQuickAgent());
        const mobileQuickAgentPage = await browser.newPage({ viewport: { width: 390, height: 844 } });
        await mobileQuickAgentPage.goto(`${baseUrl}/ui`, { waitUntil: "networkidle" });
        await mobileQuickAgentPage.waitForSelector("#quick-agent-fab:not(.hidden)", { state: "visible", timeout: 10_000 });
        await mobileQuickAgentPage.click("#quick-agent-fab");
        await mobileQuickAgentPage.waitForSelector("#quick-agent-prompt", { state: "visible", timeout: 10_000 });
        await mobileQuickAgentPage.click("[data-quick-agent-toggle]");
        await mobileQuickAgentPage.waitForSelector("#quick-agent-effort", { state: "visible", timeout: 10_000 });
        const quickAgentMobileLayout = await mobileQuickAgentPage.evaluate(() => {
          const dialog = document.querySelector("#quick-agent-dialog");
          const form = document.querySelector("#quick-agent-form");
          return {
            viewport: { width: window.innerWidth, height: window.innerHeight },
            dialog: dialog?.getBoundingClientRect().toJSON(),
            form: form?.getBoundingClientRect().toJSON(),
            formOverflowY: form ? getComputedStyle(form).overflowY : "",
          };
        });
        if (quickAgentMobileLayout.dialog?.x !== 0 || quickAgentMobileLayout.dialog?.y !== 0 ||
            quickAgentMobileLayout.dialog?.width !== quickAgentMobileLayout.viewport.width ||
            quickAgentMobileLayout.dialog?.height !== quickAgentMobileLayout.viewport.height ||
            quickAgentMobileLayout.form?.x !== 0 || quickAgentMobileLayout.form?.y !== 0 ||
            quickAgentMobileLayout.form?.width !== quickAgentMobileLayout.viewport.width ||
            quickAgentMobileLayout.form?.height !== quickAgentMobileLayout.viewport.height ||
            !["auto", "scroll"].includes(quickAgentMobileLayout.formOverflowY)) {
          throw new Error(`Quick Agent form is not a scrollable mobile full-screen surface: ${JSON.stringify(quickAgentMobileLayout)}`);
        }
        await mobileQuickAgentPage.evaluate((key) => {
          closeQuickAgent();
          const agent = findAgent(key);
          agent.attachments = Array.from({ length: 5 }, (_, index) => ({
            id: `mobile-attachment-${index}`,
            agent_key: key,
            type: "file",
            title: `report-${index + 1}.html`,
            path: `/Users/smoke/Code/example-project/very-long-report-directory/report-${index + 1}.html`,
            blob_path: `/attachments/mobile-attachment-${index}/blob`,
            format: "html",
          }));
          history.replaceState(null, "", routeHash({ type: "agent", key }));
          state.renderedRouteKey = null;
          state.renderedViewHtml = "";
          render();
        }, agentKey);
        await mobileQuickAgentPage.waitForSelector("[data-toggle-attachments]", { state: "visible", timeout: 10_000 });
        await mobileQuickAgentPage.click("[data-toggle-attachments]");
        await mobileQuickAgentPage.waitForSelector("[data-attachment-flyout]:not(.hidden)", { state: "visible", timeout: 10_000 });
        const mobileAttachmentFlyout = await mobileQuickAgentPage.evaluate(() => {
          const flyout = document.querySelector("[data-attachment-flyout]:not(.hidden)");
          const header = flyout?.querySelector(".attachment-panel-header");
          const dock = document.querySelector("[data-agent-dock]");
          const flyoutRect = flyout?.getBoundingClientRect();
          const headerRect = header?.getBoundingClientRect();
          const headerHit = headerRect
            ? document.elementFromPoint(headerRect.left + headerRect.width / 2, headerRect.top + headerRect.height / 2)
            : null;
          return {
            viewport: { width: window.innerWidth, height: window.innerHeight },
            flyout: flyoutRect?.toJSON(),
            dock: dock?.getBoundingClientRect().toJSON(),
            dockOverflowY: dock ? getComputedStyle(dock).overflowY : "",
            headerVisible: Boolean(headerHit && flyout?.contains(headerHit)),
          };
        });
        if (!mobileAttachmentFlyout.headerVisible || mobileAttachmentFlyout.flyout?.top < 0 ||
            mobileAttachmentFlyout.flyout?.left < 0 ||
            mobileAttachmentFlyout.flyout?.right > mobileAttachmentFlyout.viewport.width ||
            mobileAttachmentFlyout.flyout?.bottom > mobileAttachmentFlyout.viewport.height) {
          throw new Error(`Conversation attachments are cropped on mobile: ${JSON.stringify(mobileAttachmentFlyout)}`);
        }
        if (captureDir) await mobileQuickAgentPage.screenshot({ path: path.join(captureDir, "attachment-flyout-mobile.png") });
        await mobileQuickAgentPage.close();
        const loopAgentKey = await page.evaluate(async () => {
          const data = await apiPost("/agents", {
            project_key: "web",
            template_key: "custom",
            name: "Review Loop Smoke Agent",
            prompt: "Work on the open pull request.",
            agent: "codex",
          });
          return data.agent.key;
        });
        await page.goto(`${baseUrl}/ui#agent/${encodeURIComponent(loopAgentKey)}`, { waitUntil: "networkidle" });
        await page.waitForSelector("#header-more-button:not(.hidden)", { state: "visible", timeout: 10_000 });
        await page.click("#header-more-button");
        await page.waitForSelector(`[data-loop-agent='${loopAgentKey}']`, { state: "visible", timeout: 10_000 });
        await page.click(`[data-loop-agent='${loopAgentKey}']`);
        await page.waitForSelector("#agent-loop-form", { state: "visible", timeout: 10_000 });
        const loopFormDefaults = {
          interval: await page.locator("#agent-loop-interval").inputValue(),
          template: await page.locator("#agent-loop-template").inputValue(),
          message: await page.locator("#agent-loop-message").inputValue(),
          endsAt: await page.locator("#agent-loop-ends-at").inputValue(),
        };
        if (loopFormDefaults.interval !== "11" || loopFormDefaults.template !== "" || loopFormDefaults.message !== "") {
          throw new Error(`Session loop form did not use saved defaults with an empty prompt: ${JSON.stringify(loopFormDefaults)}`);
        }
        if (new Date(loopFormDefaults.endsAt).getTime() <= Date.now()) {
          throw new Error(`Session loop default end time is not in the future: ${JSON.stringify(loopFormDefaults.endsAt)}`);
        }
        await page.selectOption("#agent-loop-template", "pull-request-review");
        const selectedLoopPrompt = await page.locator("#agent-loop-message").inputValue();
        if (selectedLoopPrompt !== loopTemplatePrompt) {
          throw new Error(`Session loop prompt template did not fill the preview: ${JSON.stringify(selectedLoopPrompt)}`);
        }
        const loopScheduleKey = await page.locator("#agent-loop-form [name='schedule_key']").inputValue();
        await page.click("#agent-loop-form button[type='submit']");
        await page.waitForSelector("#header-schedule-menu:not(.hidden)", { state: "visible", timeout: 10_000 });
        const loopSchedule = await page.evaluate((key) => state.schedules.find((schedule) => schedule.key === key), loopScheduleKey);
        if (!loopSchedule || loopSchedule.target_agent_key !== loopAgentKey || loopSchedule.cron !== "*/11 * * * *" || !loopSchedule.ends_at) {
          throw new Error(`Created session loop is not a normal expiring schedule: ${JSON.stringify(loopSchedule)}`);
        }
        await page.evaluate(() => navigate({ type: "tab", tab: "now" }));
        await page.waitForSelector("[data-state-key='schedule-now-details']", { state: "visible", timeout: 10_000 });
        await page.evaluate(() => { document.querySelector("[data-state-key='schedule-now-details']").open = true; });
        const scheduleRowText = await page.evaluate((key) => document.querySelector(`[data-schedule-key='${key}']`)?.closest(".schedule-row")?.innerText || "", loopScheduleKey);
        if (!scheduleRowText.includes("Review Loop Smoke Agent") || !scheduleRowText.includes("ends")) {
          throw new Error(`Session loop is missing from the Schedules list: ${JSON.stringify(scheduleRowText)}`);
        }
        if (errors.length) throw new Error(`Browser console errors: ${errors.join(" | ")}`);
        console.log("remote-ui-smoke: ok");
      } finally {
        await browser.close();
      }
    }

    main().catch((error) => {
      console.error(error);
      process.exit(1);
    });
  JS
end

browser = ensure_browser_prerequisites!

Dir.mktmpdir("tycho-remote-ui-smoke") do |dir|
  fixture = write_fixture(dir)
  github_server, github_thread = start_fake_github_api
  github_api_url = "http://127.0.0.1:#{github_server.addr[1]}"
  port = free_port
  base_url = "http://127.0.0.1:#{port}"
  log_path = File.join(dir, "remote-server.log")
  env = {
    "TYCHO_SKILLS_HOME" => fixture.fetch(:home_dir),
    "TYCHO_CONFIG_PATH" => fixture.fetch(:config_path),
    "TYCHO_SYSTEM_PROMPTS_PATH" => fixture.fetch(:prompts_path),
    "TYCHO_RESPONSE_STYLE_PATH" => fixture.fetch(:response_style_path),
    "TYCHO_SCHEDULES_PATH" => fixture.fetch(:schedules_path),
    "TYCHO_LOGS_ROOT" => fixture.fetch(:logs_dir),
    "TYCHO_CODEX_BIN" => fixture.fetch(:fake_codex_path),
    "TYCHO_GH_BIN" => fixture.fetch(:fake_gh_path),
    "TYCHO_GITHUB_APP_CLIENT_ID" => "smoke-client-id",
    "TYCHO_GITHUB_APP_SLUG" => "tycho-smoke",
    "TYCHO_REMOTE_TOKEN" => "",
    "TYCHO_GITHUB_API_URL" => github_api_url
  }

  @server_pid = Process.spawn(
    env,
    RbConfig.ruby, "bin/tycho", "serve", "--host", "127.0.0.1", "--port", port.to_s,
    chdir: ROOT,
    out: [log_path, "w"],
    err: %i[child out],
    pgroup: true
  )

  begin
    wait_for_remote(base_url, log_path)
    mark_schedule_daemon_running(fixture.fetch(:logs_dir), @server_pid)
    agent_key = create_agent(base_url)
    unscheduled_agent_key = create_agent(base_url, name: "Unscheduled Smoke Agent")
    archived_agent_key = create_agent(base_url, name: "Archived Smoke Agent")
    orchestrator_agent_key = create_agent(
      base_url,
      name: "Checkout Orchestrator",
      prompt: "Coordinate three focused reviews and synthesize the result."
    )
    delegated_agent_key = create_agent(
      base_url,
      name: "API contract review",
      prompt: "Review the API contract and report concise findings.",
      parent_agent_key: orchestrator_agent_key
    )
    security_agent_key = create_agent(
      base_url,
      name: "Security boundary review",
      prompt: "Review trust boundaries and report concise findings.",
      parent_agent_key: orchestrator_agent_key
    )
    mobile_agent_key = create_agent(
      base_url,
      name: "Mobile interaction review",
      prompt: "Review mobile navigation and report concise findings.",
      parent_agent_key: orchestrator_agent_key
    )
    send_agent_message(
      base_url,
      delegated_agent_key,
      "Run the delegated API contract review.",
      parent_agent_key: orchestrator_agent_key
    )
    send_agent_message(base_url, security_agent_key, "Take over this review directly.")
    associate_agent_schedule(fixture.fetch(:logs_dir), agent_key)
    associate_agent_pull_request(fixture.fetch(:logs_dir), agent_key)
    associate_agent_pull_request(fixture.fetch(:logs_dir), unscheduled_agent_key)
    wait_for_resource_agents(
      base_url,
      [agent_key, unscheduled_agent_key, orchestrator_agent_key, delegated_agent_key, security_agent_key, mobile_agent_key]
    )
    archive_agent(base_url, archived_agent_key)
    start_agent(base_url, delegated_agent_key, parent_agent_key: orchestrator_agent_key)
    wait_for_delegation_callback(base_url, orchestrator_agent_key)
    node_dir = File.join(dir, "node")
    install_playwright!(node_dir)
    script = File.join(node_dir, "remote-ui-smoke.js")
    write_smoke_script(script)

    smoke_env = {
      "TYCHO_REMOTE_UI_URL" => base_url,
      "TYCHO_REMOTE_UI_AGENT_KEY" => agent_key,
      "TYCHO_REMOTE_UI_UNSCHEDULED_AGENT_KEY" => unscheduled_agent_key,
      "TYCHO_REMOTE_UI_ARCHIVED_AGENT_KEY" => archived_agent_key,
      "TYCHO_REMOTE_UI_ORCHESTRATOR_AGENT_KEY" => orchestrator_agent_key,
      "TYCHO_REMOTE_UI_DELEGATED_AGENT_KEY" => delegated_agent_key,
      "TYCHO_REMOTE_UI_TAKEOVER_AGENT_KEY" => security_agent_key,
      "CHROME_PATH" => browser
    }
    if ENV["TYCHO_REMOTE_UI_SMOKE_RENDERING_ONLY"].to_s == "1"
      smoke_env["TYCHO_REMOTE_UI_SMOKE_RENDERING_ONLY"] = "1"
    end
    if ENV["TYCHO_REMOTE_UI_SKILLS_ONLY"].to_s == "1"
      smoke_env["TYCHO_REMOTE_UI_SKILLS_ONLY"] = "1"
    end
    capture_dir = ENV["TYCHO_REMOTE_UI_CAPTURE_DIR"].to_s.strip
    unless capture_dir.empty?
      expanded_capture_dir = File.expand_path(capture_dir, ROOT)
      if expanded_capture_dir == ROOT || expanded_capture_dir.start_with?("#{ROOT}/")
        raise "TYCHO_REMOTE_UI_CAPTURE_DIR must be outside the repository"
      end
      smoke_env["TYCHO_REMOTE_UI_CAPTURE_DIR"] = expanded_capture_dir
    end
    command = ["node", script]
    out, err, status = Open3.capture3(smoke_env, *command, chdir: node_dir)
    puts out unless out.empty?
    warn err unless err.empty?
    unless status.success?
      warn File.read(log_path) if File.exist?(log_path)
      exit(status.exitstatus || 1)
    end
  ensure
    if @server_pid && process_alive?(@server_pid)
      Process.kill("TERM", -@server_pid)
      Process.wait(@server_pid)
    end
    github_server&.close
    github_thread&.join
  end
end
