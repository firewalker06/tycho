              const title = row.querySelector(":scope > .row-title");
              const avatarRect = avatar?.getBoundingClientRect();
              const titleRect = title?.getBoundingClientRect();
              return avatarRect && titleRect ? {
                avatarLeft: avatarRect.left,
                avatarWidth: avatarRect.width,
                avatarHeight: avatarRect.height,
                titleLeft: titleRect.left,
                gap: titleRect.left - avatarRect.right,
              } : null;
            };
            return {
              rows: rows.map(measure),
              overflow: document.documentElement.scrollWidth > document.documentElement.clientWidth,
            };
          });
          const reference = alignment.rows[0];
          const aligned = reference && alignment.rows.length > 1 && alignment.rows.every((row) => row &&
            Math.abs(row.avatarLeft - reference.avatarLeft) <= 1 &&
            Math.abs(row.avatarWidth - reference.avatarWidth) <= 1 &&
