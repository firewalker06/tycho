        await page.goForward();
        await page.waitForSelector(".workspace-text-preview", { state: "visible", timeout: 10_000 });

        await page.setViewportSize({ width: 390, height: 844 });
        const mobileContract = await page.evaluate(() => ({
          overflow: document.documentElement.scrollWidth > document.documentElement.clientWidth,
          columns: getComputedStyle(document.querySelector(".workspace-browser-grid")).gridTemplateColumns,
          previewVisible: Boolean(document.querySelector(".workspace-text-preview")),
