ROOT = File.expand_path("..", __dir__)

def free_port
  server = TCPServer.new("127.0.0.1", 0)
  server.addr[1]
ensure
  server&.close
end

def write_fixture(dir)
  config_dir = File.join(dir, "config")
  home_dir = File.join(dir, "home")
  workspace = File.join(dir, "workspace")
  FileUtils.mkdir_p(config_dir)
  FileUtils.mkdir_p(home_dir)
  FileUtils.mkdir_p(workspace)

  config_path = File.join(config_dir, "hq.yml")
  prompts_path = File.join(config_dir, "system_prompts.yml")
  response_style_path = File.join(config_dir, "response_style.md")
  schedules_path = File.join(config_dir, "schedules.yml")
  fake_codex_path = File.join(dir, "fake-codex")
  fake_gh_path = File.join(dir, "fake-gh")
  File.write(config_path, <<~YAML)
    ---
    projects:
      - key: web
        name: Web
        group: Personal
        path: #{workspace.inspect}
        agent: codex
        pr_url: https://github.com/example/web/pull/123
  YAML
  File.write(prompts_path, "---\ncustom: \"Check the workspace.\"\n")
  File.write(schedules_path, <<~YAML)
    ---
    schedules:
      - key: smoke
        name: Smoke schedule
        cron: "0 9 * * 1-5"
        target:
          type: agent
          project_key: web
          message: "Exercise scheduled agent controls."
  YAML
  File.write(fake_codex_path, <<~'RUBY')
    #!/usr/bin/env ruby
    require "json"
    output_index = ARGV.index("-o")
    output = output_index ? ARGV[output_index + 1] : nil
    payload = {
      "status" => "success",
      "summary" => "Completed the focused review and returned concise findings.",
      "summary_sections" => [{ "type" => "text", "text" => "Rendered semantic run summary details.", "url" => nil, "attachment" => nil }],
      "inquiry" => nil,
      "attachments" => nil
    }
    File.write(output, JSON.generate(payload)) if output
    puts JSON.generate("type" => "thread.started", "thread_id" => "smoke-#{Process.pid}")
    puts JSON.generate("type" => "item.completed", "item" => {
      "type" => "agent_message", "text" => JSON.generate(payload)
    })
  RUBY
  File.chmod(0o755, fake_codex_path)
  File.write(fake_gh_path, <<~SH)
    #!/bin/sh
    if [ "$1" = "auth" ] && [ "$2" = "token" ]; then
      printf 'smoke-token\\n'
      exit 0
    fi
    exit 1
  SH
  File.chmod(0o755, fake_gh_path)
  FileUtils.mkdir_p(File.join(workspace, "docs"))
  FileUtils.mkdir_p(File.join(workspace, "fast"))
  FileUtils.mkdir_p(File.join(workspace, "slow"))
  FileUtils.mkdir_p(File.join(workspace, "src"))
  FileUtils.mkdir_p(File.join(workspace, "node_modules", "fixture"))
  File.write(File.join(workspace, "docs", "guide.md"), "# Workspace guide\n\nRead-only preview.\n")
  File.write(File.join(workspace, "fast", "fast.txt"), "fast\n")
  File.write(File.join(workspace, "slow", "slow.txt"), "slow\n")
  File.write(File.join(workspace, "src", "app.rb"), "puts \"fixture\"\n")
  File.binwrite(File.join(workspace, "binary.dat"), "fixture\0binary")
  File.binwrite(File.join(workspace, "large.txt"), "x" * ((256 * 1024) + 1))
  File.write(File.join(workspace, ".env"), "SECRET=not-visible\n")
  File.write(File.join(workspace, "node_modules", "fixture", "index.js"), "generated\n")
  skill_dir = File.join(workspace, ".agents", "skills", "review")
  FileUtils.mkdir_p(skill_dir)
  File.write(File.join(skill_dir, "SKILL.md"), "# Review\n")
  12.times do |index|
    dir = File.join(workspace, ".agents", "skills", "alpha-#{index.to_s.rjust(2, "0")}")
    FileUtils.mkdir_p(dir)
    File.write(File.join(dir, "SKILL.md"), "# Alpha #{index}\n")
  end

  {
    config_path: config_path,
    prompts_path: prompts_path,
    response_style_path: response_style_path,
    schedules_path: schedules_path,
    fake_codex_path: fake_codex_path,
    fake_gh_path: fake_gh_path,
    home_dir: home_dir,
    logs_dir: File.join(dir, "logs")
  }
end

def start_fake_github_api
  server = TCPServer.new("127.0.0.1", 0)
  thread = Thread.new do
    loop do
      client = server.accept
      Thread.new(client) do |socket|
        request_line = socket.gets.to_s
        method, target, = request_line.split(" ", 3)
        headers = {}
        while (line = socket.gets)
          break if line == "\r\n"

          key, value = line.split(":", 2)
          headers[key.to_s.downcase] = value.to_s.strip
        end
        length = headers.fetch("content-length", "0").to_i
        request_body = length.positive? ? socket.read(length) : ""
        path = URI(target.to_s).path
        status, content_type, body = fake_github_response(method, path, headers, request_body)
        socket.write("HTTP/1.1 #{status}\r\n")
        socket.write("Content-Type: #{content_type}\r\n")
        socket.write("Content-Length: #{body.bytesize}\r\n")
        socket.write("X-RateLimit-Limit: 5000\r\n")
        socket.write("X-RateLimit-Remaining: 4999\r\n")
        socket.write("Connection: close\r\n\r\n")
        socket.write(body)
      ensure
        socket.close
      end
    rescue IOError, Errno::EBADF
      break
    end
  end
  [server, thread]
end

def fake_github_response(method, path, headers, request_body)
  if method == "GET" && path == "/repos/example/web/pulls/123" &&
     headers["accept"].to_s.include?("application/vnd.github.diff")
    return ["200 OK", "application/vnd.github.diff", <<~DIFF]
      diff --git a/lib/example.rb b/lib/example.rb
      index 1111111..2222222 100644
      --- a/lib/example.rb
      +++ b/lib/example.rb
      @@ -1 +1 @@
      -old
      +new
    DIFF
  end

  pull = {
    "title" => "Smoke pull request",
    "body" => "A browser fixture for the complete review loop.",
    "html_url" => "https://github.com/example/web/pull/123",
    "state" => "open",
    "draft" => false,
    "mergeable" => true,
    "mergeable_state" => "clean",
    "user" => { "login" => "smoke-author" },
    "base" => { "sha" => "base-sha", "ref" => "main" },
    "head" => { "sha" => "head-sha", "ref" => "feature" },
    "changed_files" => 1,
    "additions" => 1,
    "deletions" => 1,
    "updated_at" => "2026-07-28T00:00:00Z"
  }
  return ["200 OK", "application/json", JSON.generate(pull)] if method == "GET" && path == "/repos/example/web/pulls/123"

  if method == "POST" && path == "/graphql"
    query = JSON.parse(request_body).fetch("query", "")
    pull_data = if query.include?("statusCheckRollup")
                  {
                    "reviewDecision" => nil,
                    "reviewThreads" => { "nodes" => [{ "isResolved" => false }] },
                    "commits" => {
                      "nodes" => [{
                        "commit" => {
                          "statusCheckRollup" => {
                            "state" => "SUCCESS",
                            "contexts" => {
                              "nodes" => [{ "name" => "test", "status" => "COMPLETED", "conclusion" => "SUCCESS" }]
                            }
                          }
                        }
                      }]
                    }
                  }
                else
                  {
                    "reviewThreads" => {
                      "nodes" => [{
                        "id" => "thread-1",
                        "isResolved" => false,
                        "isOutdated" => false,
                        "path" => "lib/example.rb",
                        "line" => 1,
                        "comments" => {
                          "nodes" => [{
                            "id" => "comment-1",
                            "body" => "Please verify this line.",
                            "createdAt" => "2026-07-28T00:00:00Z",
                            "url" => "https://github.com/example/web/pull/123#discussion_r1",
                            "author" => { "login" => "reviewer" }
                          }]
                        }
                      }]
                    }
                  }
                end
    body = { "data" => { "repository" => { "pullRequest" => pull_data } } }
    return ["200 OK", "application/json", JSON.generate(body)]
  end

  if method == "GET" && path.end_with?("/check-runs")
    return ["200 OK", "application/json", JSON.generate("check_runs" => [
      { "name" => "test", "status" => "completed", "conclusion" => "success" }
    ])]
  end
  if method == "GET" && path.end_with?("/commits")
    return ["200 OK", "application/json", JSON.generate([
      { "sha" => "head-sha", "commit" => { "message" => "Change example", "author" => { "name" => "Smoke", "date" => "2026-07-28T00:00:00Z" } } }
    ])]
  end
  return ["200 OK", "application/json", "[]"] if method == "GET" &&
                                                   (path.end_with?("/reviews") || path.end_with?("/comments"))

  ["404 Not Found", "application/json", JSON.generate("message" => "fixture route not found")]
end

def wait_for_remote(base_url, log_path)
  uri = URI("#{base_url}/setup")
  Timeout.timeout(15) do
    loop do
      response = Net::HTTP.get_response(uri)
      return if response.is_a?(Net::HTTPSuccess)
    rescue Errno::ECONNREFUSED, Errno::ECONNRESET
      raise "Remote server exited early:\n#{File.read(log_path)}" if @server_pid && !process_alive?(@server_pid)

      sleep 0.1
    end
  end
rescue Timeout::Error
  raise "Remote server did not become reachable:\n#{File.read(log_path)}"
end

def process_alive?(pid)
  Process.kill(0, pid)
  true
rescue Errno::ESRCH
  false
end

def create_agent(base_url, name: "Smoke Agent", prompt: "Exercise Remote UI composer preservation.", parent_agent_key: nil)
  uri = URI("#{base_url}/agents")
  request = Net::HTTP::Post.new(uri)
  request["Content-Type"] = "application/json"
  body = {
    project_key: "web",
    template_key: "custom",
    name: name,
    prompt: prompt,
    agent: "codex"
  }
  body[:parent_agent_key] = parent_agent_key if parent_agent_key
  request.body = JSON.generate(body)
  response = Net::HTTP.start(uri.hostname, uri.port) { |http| http.request(request) }
  raise "Failed to create smoke agent: #{response.code} #{response.body}" unless response.is_a?(Net::HTTPSuccess)

  JSON.parse(response.body).fetch("agent").fetch("key")
end

def archive_agent(base_url, agent_key)
  uri = URI("#{base_url}/agents/#{agent_key}/archive")
  request = Net::HTTP::Post.new(uri)
  request["Content-Type"] = "application/json"
  request.body = "{}"
  response = Net::HTTP.start(uri.hostname, uri.port) { |http| http.request(request) }
  raise "Failed to archive smoke agent: #{response.code} #{response.body}" unless response.is_a?(Net::HTTPSuccess)
end

def start_agent(base_url, agent_key, parent_agent_key: nil)
  uri = URI("#{base_url}/agents/#{agent_key}/start")
  request = Net::HTTP::Post.new(uri)
  request["Content-Type"] = "application/json"
  body = {}
  body[:parent_agent_key] = parent_agent_key if parent_agent_key
  request.body = JSON.generate(body)
  response = Net::HTTP.start(uri.hostname, uri.port) { |http| http.request(request) }
  raise "Failed to start smoke agent: #{response.code} #{response.body}" unless response.is_a?(Net::HTTPSuccess)
end

def send_agent_message(base_url, agent_key, prompt, parent_agent_key: nil, start: false)
  uri = URI("#{base_url}/agents/#{agent_key}/messages")
  request = Net::HTTP::Post.new(uri)
  request["Content-Type"] = "application/json"
  body = { prompt: prompt, start: start }
  body[:parent_agent_key] = parent_agent_key if parent_agent_key
  request.body = JSON.generate(body)
  response = Net::HTTP.start(uri.hostname, uri.port) { |http| http.request(request) }
  raise "Failed to message smoke agent: #{response.code} #{response.body}" unless response.is_a?(Net::HTTPSuccess)
end

def wait_for_delegation_callback(base_url, parent_key)
  deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + 15
  loop do
    blocks = JSON.parse(Net::HTTP.get(URI("#{base_url}/agents/#{parent_key}/conversation"))).fetch("conversation")
    return if blocks.any? { |block| block.dig("metadata", "delegation_callback") }
    raise "Delegation callback did not reach #{parent_key}" if Process.clock_gettime(Process::CLOCK_MONOTONIC) >= deadline

    sleep 0.05
  end
end

def wait_for_resource_agents(base_url, agent_keys)
  deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + 10
  loop do
    refresh_uri = URI("#{base_url}/servers/resources/refresh")
    refresh = Net::HTTP::Post.new(refresh_uri)
    refresh["Content-Type"] = "application/json"
    refresh.body = JSON.generate(force: true, tokens: {})
    Net::HTTP.start(refresh_uri.hostname, refresh_uri.port) { |http| http.request(refresh) }

    snapshot = JSON.parse(Net::HTTP.get(URI("#{base_url}/servers/resources")))
    local = Array(snapshot["servers"]).find { |server| server["key"] == "local" }
    available = Array(local&.fetch("agents", [])).map { |agent| agent["key"] }
    return if agent_keys.all? { |key| available.include?(key) }
    raise "Resource catalog did not include fixture agents: #{available.inspect}" if Process.clock_gettime(Process::CLOCK_MONOTONIC) >= deadline

    sleep 0.05
  end
end

def associate_agent_schedule(logs_dir, agent_key)
  agents_path = File.join(logs_dir, "managed_agents.json")
  agents = JSON.parse(File.read(agents_path))
  agent = agents.find { |item| item["key"] == agent_key }
  raise "Failed to find smoke agent #{agent_key.inspect}" unless agent

  agent["schedule_key"] = "smoke"
  agent["template_key"] = "scheduled"
  File.write(agents_path, JSON.pretty_generate(agents))
end

def associate_agent_pull_request(logs_dir, agent_key)
  agents_path = File.join(logs_dir, "managed_agents.json")
  agents = JSON.parse(File.read(agents_path))
  agent = agents.find { |item| item["key"] == agent_key }
  raise "Failed to find smoke agent #{agent_key.inspect}" unless agent

  attachments_path = agent.fetch("log_path").sub(/\.raw\.log\z/, ".attachments.json")
  File.write(
    attachments_path,
    JSON.pretty_generate(
      "attachments" => [{
        "kind" => "pull_request",
        "title" => "Example PR",
        "url" => "https://github.com/example/web/pull/123",
        "created_at" => Time.now.iso8601
      }]
    )
  )
end

def mark_schedule_daemon_running(logs_dir, pid)
  FileUtils.mkdir_p(logs_dir)
  now = Time.now.iso8601
  File.write(
    File.join(logs_dir, "scheduler_daemon.json"),
    JSON.pretty_generate(
      "pid" => pid,
      "mode" => "daemon",
      "dry_run" => false,
      "interval" => 30,
      "started_at" => now,
      "last_tick_started_at" => now,
      "last_tick_finished_at" => now
    )
  )
end

def chrome_path
  explicit = ENV["CHROME_PATH"].to_s
  return explicit unless explicit.empty?

  candidates = [
    "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
    "/Applications/Chromium.app/Contents/MacOS/Chromium",
    "/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge"
  ]
  candidates.find { |path| File.executable?(path) }
end

def ensure_browser_prerequisites!
  raise "node is required for Remote UI smoke checks" unless system("node", "--version", out: File::NULL, err: File::NULL)
  raise "npm is required for Remote UI smoke checks" unless system("npm", "--version", out: File::NULL, err: File::NULL)

  browser = chrome_path
  raise "Chrome/Chromium is required; set CHROME_PATH to the browser executable" unless browser

  browser
end

def install_playwright!(node_dir)
  FileUtils.mkdir_p(node_dir)
  package_json = File.join(node_dir, "package.json")
  File.write(package_json, JSON.generate("private" => true, "dependencies" => {}))
  command = [
    "npm", "install",
    "--prefix", node_dir,
    "--no-audit",
    "--fund=false",
    "--ignore-scripts",
    "playwright"
  ]
  out, err, status = Open3.capture3(*command)
  return if status.success?

  raise "Failed to install Playwright for Remote UI smoke check:\n#{out}\n#{err}"
end

def write_smoke_script(path)
  File.write(path, <<~JS)
    const { chromium } = require("playwright");
    const fs = require("fs");
    const path = require("path");

    async function main() {
      const baseUrl = process.env.TYCHO_REMOTE_UI_URL;
      const agentKey = process.env.TYCHO_REMOTE_UI_AGENT_KEY;
      const unscheduledAgentKey = process.env.TYCHO_REMOTE_UI_UNSCHEDULED_AGENT_KEY;
      const archivedAgentKey = process.env.TYCHO_REMOTE_UI_ARCHIVED_AGENT_KEY;
      const orchestratorAgentKey = process.env.TYCHO_REMOTE_UI_ORCHESTRATOR_AGENT_KEY;
      const delegatedAgentKey = process.env.TYCHO_REMOTE_UI_DELEGATED_AGENT_KEY;
      const takeoverAgentKey = process.env.TYCHO_REMOTE_UI_TAKEOVER_AGENT_KEY;
      const chromePath = process.env.CHROME_PATH;
      const captureDir = process.env.TYCHO_REMOTE_UI_CAPTURE_DIR || "";
      const beforeCapture = process.env.TYCHO_REMOTE_UI_BEFORE_CAPTURE || "";
      const skillsOnly = process.env.TYCHO_REMOTE_UI_SKILLS_ONLY === "1";
      const titleCopyOnly = process.env.TYCHO_REMOTE_UI_TITLE_COPY_ONLY === "1";
      const draft = "Remote UI smoke draft " + Date.now();
      const errors = [];

      if (captureDir) fs.mkdirSync(captureDir, { recursive: true });
      if (captureDir && beforeCapture) fs.copyFileSync(beforeCapture, path.join(captureDir, "attachment-flyout-before.png"));

      const browser = await chromium.launch({ executablePath: chromePath, headless: true });
      const page = await browser.newPage({ viewport: { width: 390, height: 844 } });
      page.on("console", (message) => {
        if (message.type() === "error") errors.push(message.text());
      });
      page.on("pageerror", (error) => errors.push(error.message));

      async function assertInitialLoadingShell() {
        const desktopPage = await browser.newPage({ viewport: { width: 1440, height: 900 } });
        const mobilePage = await browser.newPage({ viewport: { width: 390, height: 844 }, isMobile: true });
        const pwaContext = await browser.newContext({ viewport: { width: 390, height: 844 }, isMobile: true });
        const pwaPage = await pwaContext.newPage();
        try {
          await Promise.all([desktopPage, mobilePage, pwaPage].map((candidate) => candidate.route("**/ui.js?*", async (route) => {
            await new Promise((resolve) => setTimeout(resolve, 350));
            await route.continue();
          })));
          await Promise.all([desktopPage, mobilePage, pwaPage].map((candidate) => candidate.emulateMedia({ reducedMotion: candidate === mobilePage ? "reduce" : "no-preference" })));
          await Promise.all([desktopPage.goto(`${baseUrl}/`, { waitUntil: "commit" }), mobilePage.goto(`${baseUrl}/`, { waitUntil: "commit" }), pwaPage.goto(`${baseUrl}/`, { waitUntil: "commit" })]);
          await Promise.all([desktopPage, mobilePage, pwaPage].map((candidate) => candidate.waitForSelector("#tycho-boot-shell[data-state='loading']", { state: "visible", timeout: 10_000 })));
          const initialStates = await Promise.all([desktopPage, mobilePage, pwaPage].map(async (candidate) => candidate.evaluate(() => {
            const shell = document.getElementById("tycho-boot-shell");
            const app = document.getElementById("app");
            return {
              state: shell?.dataset.state,
              visible: Boolean(shell && !shell.hidden && getComputedStyle(shell).display !== "none"),
              busy: app?.getAttribute("aria-busy"),
              animation: getComputedStyle(shell?.querySelector(".tycho-boot-mark")).animationName,
            };
          })));
          if (!initialStates.every((state) => state.state === "loading" && state.visible && state.busy === "true")) {
            throw new Error(`Initial loading shell was not visible before application JavaScript: ${JSON.stringify(initialStates)}`);
          }
          if (initialStates[1].animation !== "none") throw new Error("Reduced-motion loading shell still animates");
          if (captureDir) {
            await desktopPage.screenshot({ path: path.join(captureDir, "pwa-loading-shell-desktop.png"), fullPage: false });
            await mobilePage.screenshot({ path: path.join(captureDir, "pwa-loading-shell-mobile-reduced-motion.png"), fullPage: false });
            await pwaPage.screenshot({ path: path.join(captureDir, "pwa-loading-shell-pwa.png"), fullPage: false });
          }
          await Promise.all([desktopPage, mobilePage, pwaPage].map((candidate) => candidate.waitForSelector("#tycho-boot-shell[hidden]", { state: "attached", timeout: 10_000 })));
          const manifest = await pwaPage.evaluate(async () => (await fetch("/manifest.webmanifest")).json());
          if (manifest.display !== "standalone" || manifest.background_color !== "#282a36") {
            throw new Error(`Installed-PWA fallback contract changed: ${JSON.stringify(manifest)}`);
          }
        } finally {
          await desktopPage.close();
          await mobilePage.close();
          await pwaContext.close();
        }
      }

      if (process.env.TYCHO_REMOTE_UI_SMOKE_RENDERING_ONLY !== "1") await assertInitialLoadingShell();

      async function assertLoadingShellFailureRecovery() {
        const failurePage = await browser.newPage({ viewport: { width: 390, height: 844 } });
        let failureMode = "offline";
        try {
          await failurePage.route("**/servers/resources", async (route) => {
            if (failureMode === "offline") return route.abort("failed");
            if (failureMode === "failed") {
              return route.fulfill({ status: 500, contentType: "application/json", body: JSON.stringify({ error: "Fixture service failed" }) });
            }
            return route.continue();
          });
          await failurePage.goto(`${baseUrl}/`, { waitUntil: "domcontentloaded" });
          await failurePage.waitForSelector("#tycho-boot-shell[data-state='offline']", { state: "visible", timeout: 10_000 });
          const offlineCopy = await failurePage.locator("#tycho-boot-message").innerText();
          if (!offlineCopy.includes("offline")) throw new Error(`Offline startup copy was not actionable: ${offlineCopy}`);
          failureMode = "success";
          await failurePage.locator("#tycho-boot-retry").click();
          await failurePage.waitForSelector("#tycho-boot-shell[hidden]", { state: "attached", timeout: 10_000 });

          failureMode = "failed";
          await failurePage.reload({ waitUntil: "domcontentloaded" });
          await failurePage.waitForSelector("#tycho-boot-shell[data-state='failed']", { state: "visible", timeout: 10_000 });
          const failedCopy = await failurePage.locator("#tycho-boot-message").innerText();
          if (!failedCopy.includes("Fixture service failed") || failedCopy.includes("offline")) {
            throw new Error(`Non-network startup failure lost its cause: ${failedCopy}`);
          }
          failureMode = "success";
          await failurePage.locator("#tycho-boot-retry").click();
          await failurePage.waitForSelector("#tycho-boot-shell[hidden]", { state: "attached", timeout: 10_000 });
        } finally {
          await failurePage.close();
        }
      }

      if (process.env.TYCHO_REMOTE_UI_SMOKE_RENDERING_ONLY !== "1") await assertLoadingShellFailureRecovery();

      async function captureVisibleComposer(filename) {
        if (!captureDir) return;
        const composer = page.locator("#composer:not([hidden])");
        await composer.waitFor({ state: "visible", timeout: 10_000 });
        const bounds = await composer.boundingBox();
        if (!bounds) throw new Error("Visible composer had no screenshot bounds");
        const viewport = page.viewportSize();
        const padding = 36;
        const x = Math.max(0, bounds.x - padding);
        const y = Math.max(0, bounds.y - padding);
        const clip = {
          x,
          y,
          width: Math.min(viewport.width, bounds.x + bounds.width + padding) - x,
          height: Math.min(viewport.height, bounds.y + bounds.height + padding) - y,
        };
        await page.screenshot({ path: path.join(captureDir, filename), clip });
      }

      async function ensureSkillAutocompleteVisible() {
        for (let attempt = 0; attempt < 20; attempt += 1) {
          if (await page.locator("[data-skill-autocomplete]:not(.hidden)").isVisible()) return;
          await page.evaluate(() => {
            const prompt = document.querySelector("#prompt-input");
            prompt?.focus();
            if (prompt) refreshSkillAutocomplete(prompt);
          });
          await page.waitForTimeout(100);
        }
        throw new Error("Skill autocomplete did not become visible");
      }

      async function assertResourceCatalogCompatibility() {
        const catalogTimings = await page.evaluate(async () => {
          const samples = [];
          for (let index = 0; index < 20; index += 1) {
            const startedAt = performance.now();
            const response = await fetch("/servers/resources", { cache: "no-store" });
            if (!response.ok) throw new Error(`Catalog request failed with ${response.status}`);
            await response.json();
            samples.push(performance.now() - startedAt);
          }
          return samples.sort((left, right) => left - right);
        });
        const catalogP95 = catalogTimings[Math.ceil(catalogTimings.length * 0.95) - 1];
        if (catalogP95 >= 50) {
          throw new Error(`Cached resource catalog p95 exceeded 50ms: ${catalogP95.toFixed(1)}ms`);
        }

        const legacyPage = await browser.newPage({ viewport: { width: 390, height: 844 } });
        try {
          await legacyPage.route("**/servers/resources", async (route) => {
            await route.fulfill({
              status: 404,
              contentType: "application/json",
              body: JSON.stringify({ error: "Not found" }),
            });
          });
          await legacyPage.goto(`${baseUrl}/ui#agents`, { waitUntil: "networkidle" });
          await legacyPage.waitForSelector(`[data-open-agent='${agentKey}']`, { state: "visible", timeout: 10_000 });
          const legacyCatalogState = await legacyPage.evaluate(() => ({
            mode: state.resourceCatalogMode,
            connection: state.connection,
            localAgents: state.agents.filter((agent) => agent.server_key === "local").length,
          }));
          if (legacyCatalogState.mode !== "legacy" ||
              legacyCatalogState.connection.startsWith("Offline:") ||
              legacyCatalogState.localAgents < 1) {
            throw new Error(`Legacy Remote daemon fallback failed: ${JSON.stringify(legacyCatalogState)}`);
          }
        } finally {
          await legacyPage.close();
        }
      }

      async function assertNowStatusIcons() {
        const result = await page.evaluate(() => {
          const original = {
            agents: state.agents,
            schedules: state.schedules,
            scheduleDaemon: state.scheduleDaemon,
          };
          const source = state.agents[0];
          if (!source) throw new Error("Now status icon fixture needs an agent");

          state.agents = [
            {
              ...source,
              key: "running-status-icon",
              name: "Work in flight",
              status: "running",
              running: true,
              unread: false,
              awaiting_input: false,
              blocked: false,
              last_result: "",
            },
            {
              ...source,
              key: "unread-status-icon",
              name: "Fresh result",
              status: "success",
              running: false,
              unread: true,
              awaiting_input: false,
              blocked: false,
            },
          ];
          state.schedules = [];
          state.scheduleDaemon = {};
          renderNow();

          const rows = Array.from(document.querySelectorAll(".agent-summary-card")).map((row) => {
            const icon = row.querySelector(".agent-status-icon");
            const styles = icon ? getComputedStyle(icon) : null;
            return {
              label: row.querySelector(".card-title strong")?.textContent,
              iconClass: icon?.className || "",
              iconLabel: icon?.getAttribute("aria-label"),
              iconTitle: icon?.getAttribute("title"),
              iconText: icon?.textContent.trim() || "",
              hasPill: Boolean(icon?.parentElement?.querySelector(".ui-badge, .pill, .chip, .agent-status-badge")),
              background: styles?.backgroundColor,
              border: styles?.borderWidth,
              radius: styles?.borderRadius,
            };
          });

          state.agents = original.agents;
          state.schedules = original.schedules;
          state.scheduleDaemon = original.scheduleDaemon;
          state.renderedRouteKey = null;
          state.renderedViewHtml = "";
          render();
          return rows;
        });

        const running = result.find((row) => row.iconLabel === "Running");
        const unread = result.find((row) => row.iconLabel === "Unread");
        const iconIsStandalone = (row) => row && !row.iconText && !row.hasPill &&
          (row.background === "rgba(0, 0, 0, 0)" || row.background === "transparent") &&
          row.border === "0px" && row.radius === "0px";
        if (!running?.iconClass.includes("running") || running.iconTitle !== "Running" || !iconIsStandalone(running)) {
          throw new Error(`Now running status icon lost its standalone accessible treatment: ${JSON.stringify(running)}`);
        }
        if (!unread?.iconClass.includes("need") || unread.iconTitle !== "Unread" || !iconIsStandalone(unread)) {
          throw new Error(`Now unread status icon lost its standalone accessible treatment: ${JSON.stringify(unread)}`);
        }
      }

      async function assertEditorExcludedFromRefresh(selector, label, focusSelector) {
        if (focusSelector) await page.focus(focusSelector);
        const result = await page.evaluate(({ selector, label }) => {
          const editor = document.querySelector(selector);
          if (!editor) return { sameNode: false, sameFocus: false, blurred: false };
          editor.__tychoRefreshProbe = label;
          state.renderedViewHtml = "";
          let blurred = false;
          const control = document.activeElement;
          control?.addEventListener("blur", () => { blurred = true; }, { once: true });
          render({ preserveLiveEditor: true });
          return {
            sameNode: document.querySelector(selector)?.__tychoRefreshProbe === label,
            sameFocus: document.activeElement === control,
            blurred,
          };
        }, { selector, label });
        if (!result.sameNode || !result.sameFocus || result.blurred) throw new Error(`${label} did not remain stable during a polling render: ${JSON.stringify(result)}`);
      }

      async function assertSkillInstallation() {
        const skillsSection = page.locator("[data-scroll-settings-section='settings-skills']");
        await skillsSection.click();
        await page.waitForFunction(() => (
          document.querySelector("[data-scroll-settings-section='settings-skills']")?.getAttribute("aria-current") === "location"
        ));
        const codexSkillRow = page.locator("[data-skill-installation-harness='codex']");
        const initialSkillState = await codexSkillRow.innerText();
        const installSkillButton = codexSkillRow.locator("[data-skill-action='install']");
        const skillGeometry = await codexSkillRow.evaluate((row) => ({
          overflow: document.documentElement.scrollWidth > document.documentElement.clientWidth,
          buttonHeight: row.querySelector("[data-skill-action]")?.getBoundingClientRect().height,
          sourceVisible: Boolean(document.querySelector("#settings-skills .skill-installation-source")),
        }));
        if (!initialSkillState.includes("Missing") || !initialSkillState.includes(".agents/skills") ||
            skillGeometry.overflow || skillGeometry.buttonHeight < 44 || !skillGeometry.sourceVisible) {
          throw new Error(`Skill settings lost missing status, official path, or mobile geometry: ${JSON.stringify({ initialSkillState, skillGeometry })}`);
        }
        await installSkillButton.click();
        await page.waitForSelector("#confirmation-dialog[open]", { state: "visible", timeout: 10_000 });
        const skillConfirmation = await page.evaluate(() => ({
          title: document.querySelector("#confirmation-title")?.textContent,
          description: document.querySelector("#confirmation-description")?.textContent,
          cancelFocused: document.activeElement?.hasAttribute("data-confirmation-cancel"),
        }));
        if (skillConfirmation.title !== "Install Tycho skills for codex?" ||
            !skillConfirmation.description?.includes(".agents/skills") || !skillConfirmation.cancelFocused) {
          throw new Error(`Skill install confirmation is incomplete: ${JSON.stringify(skillConfirmation)}`);
        }
        await page.keyboard.press("Escape");
        await page.waitForFunction(() => (
          !document.querySelector("#confirmation-dialog")?.open &&
          document.activeElement?.matches("[data-skill-installation-harness='codex'] [data-skill-action='install']")
        ));
        await installSkillButton.click();
        await page.waitForSelector("#confirmation-dialog[open]", { state: "visible", timeout: 10_000 });
        await page.click("[data-confirmation-accept]");
        await page.waitForFunction(() => (
          document.querySelector("#growl")?.textContent === "Installed tycho for codex" &&
          document.querySelector("[data-skill-installation-harness='codex']")?.textContent.includes("Installed")
        ), null, { timeout: 10_000 });
        if (captureDir) {
          await page.setViewportSize({ width: 390, height: 1400 });
          await page.evaluate(() => {
            const top = document.querySelector("#settings-skills")?.offsetTop || 0;
            window.scrollTo({ top: Math.max(0, top - 180), behavior: "auto" });
          });
          await page.screenshot({ path: path.join(captureDir, "skills-panel-mobile.png") });
          await page.setViewportSize({ width: 1440, height: 900 });
          await page.evaluate(() => {
            const top = document.querySelector("#settings-skills")?.offsetTop || 0;
            window.scrollTo({ top: Math.max(0, top - 180), behavior: "auto" });
          });
          await page.screenshot({ path: path.join(captureDir, "skills-panel-desktop.png") });
          await page.setViewportSize({ width: 390, height: 844 });
        }
      }

      async function assertProjectWorkspaceBrowser() {
        const consoleErrorStart = errors.length;
        await page.goto(`${baseUrl}/ui#project/web`, { waitUntil: "networkidle" });
