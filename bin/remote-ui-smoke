            state: document.querySelector("[data-toggle-speech-mode]")?.dataset.state,
            status: document.querySelector("[data-speech-mode-status]")?.textContent,
            label: document.querySelector("[data-toggle-speech-mode]")?.getAttribute("aria-label"),
