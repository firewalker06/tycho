{
  "name": "Schedule Resume",
  "url": "http://127.0.0.1:7373/",
  "timeoutMs": 30000,
  "steps": [
    { "action": "open", "url": "/ui#schedules" },
    {
      "action": "measure",
      "name": "Resume changes to Pause",
      "trigger": {
        "action": "click",
        "selector": ".schedule-toggle-button[data-schedule-key='smoke']",
        "text": "Resume"
      },
      "expect": {
        "selector": ".schedule-toggle-button[data-schedule-key='smoke']",
        "text": "Pause"
      },
      "screenshot": ".schedule-row:has([data-schedule-key='smoke'])",
      "withinMs": 100
    }
  ]
}
