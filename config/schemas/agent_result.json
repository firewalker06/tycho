{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": ["success", "partial", "failed", "blocked", "input_required"]
    },
    "summary": {
      "type": "string"
    },
    "inquiry": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "message": {
          "type": ["string", "null"]
        },
        "fields": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "description": {
                "type": ["string", "null"]
              },
              "input_type": {
                "type": "string",
                "enum": ["text", "multiline", "number", "integer", "boolean", "select", "multi_select"]
              },
              "required": {
                "type": "boolean"
              },
              "options": {
                "type": ["array", "null"],
                "items": {
                  "type": "string"
                }
              }
            },
            "required": ["key", "label", "description", "input_type", "required", "options"]
