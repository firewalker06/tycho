        "properties": {
          "type": {
            "type": "string",
            "enum": ["file", "link"]
          },
          "title": {
            "type": "string"
          },
          "path": {
            "type": ["string", "null"]
          },
          "url": {
            "type": ["string", "null"]
          },
          "description": {
            "type": ["string", "null"]
          },
          "mime_type": {
            "type": ["string", "null"]
          }
        },
        "required": ["type", "title", "path", "url", "description", "mime_type"]
      }
    }
  },
  "required": ["status", "summary", "inquiry", "attachments"]
}
