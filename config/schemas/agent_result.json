{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "description": "Classify what happened during this run. Use input_required when human input is needed, blocked when an external change is required, failed when the work failed, partial when required work remains, and success when you completed a requested action, change, answer, commit, review, or deliverable. Use no_action_needed only for a successful observational or recurring check where no new condition required action and no requested action or deliverable was completed. no_action_needed is a quiet outcome that suppresses operator unread and push notifications; never use it merely because completed work leaves no next steps.",
      "enum": ["success", "no_action_needed", "partial", "failed", "blocked", "input_required"]
    },
    "summary": {
      "type": "string",
      "description": "Concise operator-facing Markdown summary of this run. State the outcome, important changes or findings, blockers, and concrete next steps. Keep it focused enough for the Remote UI Summary page: usually 1-3 short paragraphs or bullets. After summarized, do a secondary check to not miss important details."
    },
    "summary_sections": {
      "type": ["array", "null"],
      "description": "Always provide a non-empty summary as the concise preview. Set summary_sections to null for simple runs. For substantive runs such as investigations, reviews, builds, or plans with multiple findings, decisions, or verification results, provide ordered rich blocks as a standalone expanded account used instead of summary on the full Summary page. Put headings, bullets, numbered lists, tables, and prose in Markdown text blocks; use link and attachment blocks for their respective targets. Set every unused block field to null. Keep the array in reading order. Example Markdown list block: {\"type\":\"text\",\"text\":\"## Findings\\n- First\\n- Second\",\"url\":null,\"attachment\":null}.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": { "type": "string", "enum": ["text", "link", "attachment"] },
          "text": { "type": ["string", "null"] },
          "url": { "type": ["string", "null"] },
          "attachment": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
              "type": { "type": "string", "enum": ["file", "link"] },
              "title": { "type": "string" },
              "path": { "type": ["string", "null"] },
              "url": { "type": ["string", "null"] },
              "description": { "type": ["string", "null"] },
              "mime_type": { "type": ["string", "null"] }
            },
            "required": ["type", "title", "path", "url", "description", "mime_type"]
          }
        },
        "required": ["type", "text", "url", "attachment"]
      }
    },
    "inquiry": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "message": {
          "type": ["string", "null"]
        },
        "fields": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "description": {
                "type": ["string", "null"]
              },
              "input_type": {
                "type": "string",
                "enum": ["text", "multiline", "number", "integer", "boolean", "select", "multi_select"]
              },
              "required": {
                "type": "boolean"
              },
              "options": {
                "type": ["array", "null"],
                "items": {
                  "type": "string"
                }
              }
            },
            "required": ["key", "label", "description", "input_type", "required", "options"]
          }
        }
      },
      "required": ["message", "fields"]
    },
    "attachments": {
      "type": ["array", "null"],
      "description": "Durable artifacts and links produced or used by this run. When the run reviews or changes a pull request, include its canonical https://github.com/{owner}/{repo}/pull/{number} URL as a link attachment and summarize the review outcome in summary.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": ["file", "link"]
          },
          "title": {
            "type": "string"
          },
          "path": {
            "type": ["string", "null"]
          },
          "url": {
            "type": ["string", "null"]
          },
          "description": {
            "type": ["string", "null"]
          },
          "mime_type": {
            "type": ["string", "null"]
          }
        },
        "required": ["type", "title", "path", "url", "description", "mime_type"]
      }
    },
    "action_proposals": {
      "type": ["array", "null"],
      "description": "Optional Personal Assistant action proposals. Propose only allowlisted actions with declarative arguments. Tycho supplies server and delegation identity and requires a separate exact confirmation for every mutation.",
      "items": {
        "anyOf": [
          { "type": "object", "additionalProperties": false, "properties": { "type": { "type": "string", "enum": ["read_docs"] }, "description": { "type": "string" }, "arguments": { "type": "object", "additionalProperties": false, "properties": { "path": { "type": "string" } }, "required": ["path"] } }, "required": ["type", "description", "arguments"] },
          { "type": "object", "additionalProperties": false, "properties": { "type": { "type": "string", "enum": ["search_docs"] }, "description": { "type": "string" }, "arguments": { "type": "object", "additionalProperties": false, "properties": { "query": { "type": "string" } }, "required": ["query"] } }, "required": ["type", "description", "arguments"] },
          { "type": "object", "additionalProperties": false, "properties": { "type": { "type": "string", "enum": ["inspect_agents", "inspect_projects"] }, "description": { "type": "string" }, "arguments": { "type": "object", "additionalProperties": false, "properties": {}, "required": [] } }, "required": ["type", "description", "arguments"] },
          { "type": "object", "additionalProperties": false, "properties": { "type": { "type": "string", "enum": ["install_or_update_tycho_skill"] }, "description": { "type": "string" }, "arguments": { "type": "object", "additionalProperties": false, "properties": { "harness": { "type": "string" }, "action": { "type": "string" } }, "required": ["harness", "action"] } }, "required": ["type", "description", "arguments"] },
          { "type": "object", "additionalProperties": false, "properties": { "type": { "type": "string", "enum": ["create_agent"] }, "description": { "type": "string" }, "arguments": { "type": "object", "additionalProperties": false, "properties": { "project_key": { "type": "string" }, "name": { "type": "string" }, "prompt": { "type": "string" }, "agent": { "type": ["string", "null"] }, "model": { "type": ["string", "null"] }, "reasoning_effort": { "type": ["string", "null"] } }, "required": ["project_key", "name", "prompt", "agent", "model", "reasoning_effort"] } }, "required": ["type", "description", "arguments"] },
          { "type": "object", "additionalProperties": false, "properties": { "type": { "type": "string", "enum": ["message_agent"] }, "description": { "type": "string" }, "arguments": { "type": "object", "additionalProperties": false, "properties": { "agent_key": { "type": "string" }, "prompt": { "type": "string" } }, "required": ["agent_key", "prompt"] } }, "required": ["type", "description", "arguments"] },
          { "type": "object", "additionalProperties": false, "properties": { "type": { "type": "string", "enum": ["start_agent", "stop_agent"] }, "description": { "type": "string" }, "arguments": { "type": "object", "additionalProperties": false, "properties": { "agent_key": { "type": "string" } }, "required": ["agent_key"] } }, "required": ["type", "description", "arguments"] }
        ]
      }
    },
    "memory_handoff": {
      "type": ["object", "null"],
      "description": "For a successful run that should enter Second Brain, provide the concise semantic handoff. Tycho stores it with run-owned provenance; do not include run IDs, server, project, timestamps, or group here.",
      "additionalProperties": false,
      "properties": {
        "outcome": { "type": "string", "minLength": 1 },
        "decisions": { "type": "array", "items": { "type": "string" } },
        "continuing_context": { "type": "string" },
        "references": { "type": "array", "items": { "type": "string" } },
        "lessons": { "type": ["array", "null"], "items": { "type": "string" } },
        "promotion_candidates": { "type": ["array", "null"], "items": { "type": "string" } }
      },
      "required": ["outcome", "decisions", "continuing_context", "references", "lessons", "promotion_candidates"]
    }
  },
  "required": ["status", "summary", "summary_sections", "inquiry", "attachments", "action_proposals", "memory_handoff"]
}
