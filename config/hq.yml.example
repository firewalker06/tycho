---
# Tycho copies this file to ~/.tycho/config/hq.yml on first setup.
# Add entries for your local projects when you are ready.
#
#
# Fields:
#   key     (required) unique identifier used for logs, agent files, and UI keys
#   name    (required) display name in the TUI
#   group   (optional) group header projects are bucketed under
#   path    (required) absolute path to the project checkout on this machine
#   agent   (optional) managed-agent backend: "codex", "claude", "opencode", "pi", or a custom_harnesses key
#   model   (optional) default model string for new managed agents
#   reasoning_effort (optional) default effort string for new managed agents
#   response_style (optional) custom response guidance, or false to disable the global policy
#   hidden  (optional) true hides the project and its agents; false overrides a hidden group
#
# Groups can define shared metadata by display name. Missing hidden settings are
# visible by default; project-level hidden values override group-level values.

# Custom harness profiles let Tycho run a wrapper for one built-in adapter
# family: codex, claude, opencode, or pi. `adapter` selects that family's fixed
# command flags, JSON event parser, session resume, structured-output behavior,
# permissions, catalogs, metrics, and skills. Tycho does not accept custom flag
# or parser templates, so the wrapper must implement the selected native CLI and
# JSON event contract. `execution_command` can be a string or argv list; use an
# `env KEY=value ...` prefix when the wrapper needs local environment settings.
#
# Harness catalogs are optional UI suggestions for model and effort pickers.
# They are additive to Tycho's discovered/default catalogs and are not
# validation allowlists.

custom_harnesses: []
harness_catalogs: {}
groups: {}
projects: []

# The Personal Assistant is disabled until explicitly configured from Remote UI.
# personal_assistant:
#   enabled: true
#   model: gpt-5.6-sol
#   reasoning_effort: medium
#   timezone: Asia/Jakarta
#   personality: balanced # balanced, direct, steady, or upbeat
#   external_events_prompt: >-
#     Scan broadly useful current news in the style of Yahoo News or MSN across
#     world events, technology, business, science, and culture.

# Example custom harness profile:
#
# custom_harnesses:
# - key: company-codex
#   adapter: codex
#   execution_command:
#     - env
#     - COMPANY_PROFILE=work
#     - /Users/you/bin/codex-wrapper
#     - --gateway
#     - company
# - key: claude-wrapper
#   adapter: claude
#   execution_command: "/Users/you/bin/claude-wrapper"
#
# harness_catalogs:
#   claude:
#     models:
#       - claude-sonnet-5
#       - my-gateway/claude
#     reasoning_efforts:
#       - low
#       - high

# Example projects:
#
# groups:
#   Personal:
#     hidden: false
#
# projects:
# - key: my-workspace
#   name: My Workspace
#   group: Personal
#   path: "/Users/you/Code/my-workspace"
#   agent: codex
#   model: gpt-5.6-sol
#   reasoning_effort: medium
#   response_style: default
#
# - key: notes
#   name: Notes
#   group: Personal
#   path: "/Users/you/Documents/Notes"
#
# - key: work-web
#   name: Work Web
#   group: Work
#   path: "/Users/you/Code/work/web"
#   agent: claude-wrapper
