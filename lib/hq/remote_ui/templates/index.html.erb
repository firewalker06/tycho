<!doctype html>
<html lang="en" data-asset-version="<%= HQ::RemoteUI.asset_version %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#282a36">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="Tycho - Factorio for Agents">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <title>Tycho - Factorio for Agents</title>
    <link rel="manifest" href="/manifest.webmanifest?v=<%= HQ::RemoteUI.asset_version %>">
    <link rel="icon" href="/favicon.png?v=<%= HQ::RemoteUI.asset_version %>" type="image/png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=<%= HQ::RemoteUI.asset_version %>">
    <link rel="stylesheet" href="/ui.css?v=<%= HQ::RemoteUI.asset_version %>">
  </head>
  <body>
    <div id="pull-refresh" class="pull-refresh" aria-hidden="true">
      <svg class="pull-refresh-spinner ui-icon" aria-hidden="true" viewBox="0 0 24 24">
        <path d="M5 22h14"></path>
        <path d="M5 2h14"></path>
        <path d="M17 22v-4.172a2 2 0 0 0-.586-1.414L12 12l-4.414 4.414A2 2 0 0 0 7 17.828V22"></path>
        <path d="M7 2v4.172a2 2 0 0 0 .586 1.414L12 12l4.414-4.414A2 2 0 0 0 17 6.172V2"></path>
      </svg>
    </div>
    <div id="app" class="app-shell">
      <header class="app-header">
        <div class="header-row">
          <button id="back-button" class="icon-button ui-button ui-icon-button ui-detail-header__back hidden" type="button" aria-label="Back" title="Back">
            <svg class="ui-icon" aria-hidden="true" viewBox="0 0 24 24">
              <path d="m12 19-7-7 7-7"></path>
              <path d="M19 12H5"></path>
            </svg>
            <span class="sr-only">Back</span>
          </button>
          <div class="identity ui-detail-header__identity">
            <button id="header-mark" class="header-mark" type="button" aria-label="Open agent switcher" title="Open agent switcher" aria-expanded="false" aria-controls="unread-agents-panel">
              <img class="brand-logo" src="/remote-logo.png?v=<%= HQ::RemoteUI.asset_version %>" alt="">
            </button>
            <div class="title-block ui-detail-header__text">
              <div class="header-title-row">
                <h1 class="ui-detail-header__title" id="screen-title">Tycho - Factorio for Agents</h1>
                <button id="header-title-copy" class="header-title-copy icon-button ui-button ui-icon-button hidden" type="button" aria-label="Copy agent title" title="Copy agent title">
                  <svg class="ui-icon" aria-hidden="true" viewBox="0 0 24 24">
                    <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
                    <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
                  </svg>
                  <span class="sr-only">Copy agent title</span>
                </button>
              </div>
              <p class="ui-detail-header__metadata" id="screen-subtitle">Connecting</p>
            </div>
          </div>
          <div class="header-actions ui-detail-header__actions">
            <div id="header-view-menu" class="header-view-menu hidden"></div>
            <div id="header-schedule-menu" class="header-schedule-menu hidden"></div>
            <button id="header-more-button" class="icon-button ui-button ui-icon-button ui-detail-header__action hidden" type="button" aria-label="More actions" title="More actions" aria-haspopup="menu" aria-expanded="false" aria-controls="header-more-panel">
              <svg class="ui-icon" aria-hidden="true" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="1"></circle>
                <circle cx="19" cy="12" r="1"></circle>
                <circle cx="5" cy="12" r="1"></circle>
              </svg>
              <span id="header-more-badge" class="header-more-badge hidden" aria-hidden="true"></span>
              <span class="sr-only">More actions</span>
            </button>
          </div>
        </div>
        <form id="auth-panel" class="auth-panel hidden">
          <label for="token-input">Remote token</label>
          <div class="token-row">
            <input class="sr-only" type="text" autocomplete="username" value="hq-remote" tabindex="-1" aria-hidden="true">
            <input id="token-input" name="token" type="password" autocomplete="current-password" placeholder="Bearer token">
            <button id="save-token-button" type="button">Save</button>
          </div>
        </form>
        <section id="unread-agents-panel" class="unread-agents-panel ui-overlay-surface hidden" aria-label="Agent switcher" data-overlay-surface="agent-switcher"></section>
        <section id="header-more-panel" class="header-more-panel ui-overlay-surface hidden" aria-label="More actions" data-overlay-surface="header-more" data-overlay-kind="menu"></section>
        <section id="agent-settings-panel" class="agent-settings-panel hidden" aria-label="Conversation settings"></section>
      </header>

      <section id="growl" class="growl hidden" role="status" aria-live="polite" aria-atomic="true"></section>

      <main id="view" class="content" aria-live="polite"></main>

      <button id="quick-agent-fab" class="quick-agent-fab hidden" type="button" aria-label="New agent" title="New agent (c)">
        <svg class="ui-icon" aria-hidden="true" viewBox="0 0 24 24">
          <path d="M12 5v14"></path>
          <path d="M5 12h14"></path>
        </svg>
        <span class="quick-agent-fab-label">New agent</span>
      </button>
      <dialog id="quick-agent-dialog" class="quick-agent-dialog" aria-label="New agent"></dialog>
      <dialog id="confirmation-dialog" class="ui-confirmation-dialog" aria-labelledby="confirmation-title" aria-describedby="confirmation-description"></dialog>

      <nav id="bottom-nav" class="bottom-nav" aria-label="Primary navigation">
        <button type="button" data-tab="now">
          <span class="nav-mark" aria-hidden="true">
            <svg class="ui-icon" viewBox="0 0 24 24">
              <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
            </svg>
          </span>
          <span>Now</span>
        </button>
        <button type="button" data-tab="agents">
          <span class="nav-mark" aria-hidden="true">
            <svg class="ui-icon" viewBox="0 0 24 24">
              <path d="M12 8V4H8"></path>
              <rect width="16" height="12" x="4" y="8" rx="2"></rect>
              <path d="M2 14h2"></path>
              <path d="M20 14h2"></path>
              <path d="M9 13v2"></path>
              <path d="M15 13v2"></path>
            </svg>
          </span>
          <span>Agents</span>
        </button>
        <button type="button" data-tab="settings">
          <span class="nav-mark" aria-hidden="true">
            <svg class="ui-icon" viewBox="0 0 24 24">
              <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
          </span>
          <span>Settings</span>
        </button>
      </nav>
    </div>

    <script src="/ui-helpers.js?v=<%= HQ::RemoteUI.asset_version %>"></script>
    <script src="/ui.js?v=<%= HQ::RemoteUI.asset_version %>"></script>
  </body>
</html>
