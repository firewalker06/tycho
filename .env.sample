# Tycho Remote
#
# Copy this file to ~/.tycho/.env for installed Tycho, or to .env in this
# checkout for local development. `bin/tycho serve` loads both automatically;
# values already set in the process environment take precedence.
#
# Use a real contact URI for Apple Web Push. A mailto: value is simplest.
TYCHO_WEB_PUSH_VAPID_SUBJECT=mailto:you@example.com

# Optional: provide stable VAPID keys through env instead of using
# ~/.tycho/logs/web_push_vapid.json. Do not commit real private keys.
# TYCHO_WEB_PUSH_VAPID_PUBLIC_KEY=
# TYCHO_WEB_PUSH_VAPID_PRIVATE_KEY=

# Optional while diagnosing push delivery.
# TYCHO_LOG_LEVEL=DEBUG

# Optional: require bearer auth for the Remote UI/API. Set this before binding
# bin/tycho serve to Tailscale or another non-local interface.
# TYCHO_REMOTE_TOKEN=

# GitHub pull request review. Register a GitHub App with Device Flow enabled,
# then set its public Client ID and slug. No client secret or PAT is required.
# Install the App on every account or organization Tycho should review.
# Without an App session, Tycho remains compatible with `gh auth login`.
# TYCHO_GITHUB_APP_CLIENT_ID=
# TYCHO_GITHUB_APP_SLUG=
# TYCHO_GITHUB_APP_INSTALL_URL=https://github.com/apps/your-app/installations/new

# Review posting stays off unless both this switch and GitHub App permission
# "Pull requests: write" are enabled.
# TYCHO_GITHUB_WRITE_ENABLED=false
